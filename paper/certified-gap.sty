% ------------------------------------------------------------------ palette
% One meaning per color, used identically in the main text and the SM:
%   mpored     space: spatial transfer objects, P_s, p, moves along the length axis
%   mpoblue    imaginary time: Gibbs/MPO objects, P_tau, q, moves along the beta axis
%   tncert     conclusions: certified or admissible quantities (bounds, target region)
%   tnexclude  regions ruled out (no eigenvalue can lie there)
%   grays      spectra and weights (black!55 leading, black!25 remainder), caps, guides
% Never red or blue for an upper bound or an excluded region. The muted values
% below override the brighter defaults of tnnotes for this manuscript only.
\definecolor{mpored}{HTML}{A8625B}
\definecolor{mpoblue}{HTML}{5F7E99}
\definecolor{tncert}{HTML}{4F7F74}
\definecolor{tnexclude}{HTML}{B08A4A}
% Links in a slate blue that sits beside the palette instead of shouting over it.
\hypersetup{citecolor=blue,linkcolor=blue,urlcolor=blue}

