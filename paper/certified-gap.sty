% Energy levels with the gap in the conclusion color, overriding the red gap of
% tnnotes so that red keeps its single meaning, space.
% Endpoint fields are boundary objects (gray), not spatial ones (red).
\renewcommand{\fieldchain}[1]{\tikz[baseline=0pt,x=1em,y=1em,line width=.5pt]{
 \draw[black!55] (0,.4)--(1.8,.4);
 \foreach \x in {0,.45,.9,1.35,1.8}{\fill (\x,.4) circle[radius=.09];}
 \draw[-{Latex[length=1.2mm,width=1mm]},black!55,line width=.8pt] (-.38,-.05)--(-.38,.9);
 \draw[-{Latex[length=1.2mm,width=1mm]},black!55,line width=.8pt] (2.18,{.425-#1*.475})--(2.18,{.425+#1*.475});}}
% A whole split into a leading share and a remainder: both gray, since the split
% is a boundary quantity (the overlap share), not a spatial one.
\renewcommand{\stackbar}[1]{\tikz[baseline=0pt,x=1.8em,y=1em]{
 \fill[arxiv leading weight] (0,0) rectangle ({1-#1},.45);
 \fill[arxiv remainder weight] ({1-#1},0) rectangle (1,.45);}}
\renewcommand{\levels}{\tikz[baseline=0pt,x=1em,y=1em,line width=.6pt]{
 \draw (0,0)--(1,0);
 \foreach \y in {.5,.72,.9}{\draw[black!50,line width=.4pt] (0,\y)--(1,\y);}
 \draw[tncert,line width=1pt] (1.18,0)--(1.18,.5);}}

