% Do not force a paragraph indent after \end{proofdiagram} unless a blank line follows.
\renewenvironment{proofdiagram}
 {\par\smallskip\noindent\begin{minipage}{\columnwidth}\centering}
 {\end{minipage}\par\smallskip\@endpetrue}
% Allow \tocdepth@munge to be called before \tableofcontents without clobbering saved macros,
% and suppress main-text subsections/paragraphs from leaking into the Supplemental Material TOC.
\def\tocdepth@munge{%
 \ifx\l@section\@gobble@tw@\else
  \let\l@section@saved\l@section
  \let\l@subsection@saved\l@subsection
  \let\l@subsubsection@saved\l@subsubsection
  \let\l@paragraph@saved\l@paragraph
  \let\l@section\@gobble@tw@
  \let\l@subsection\@gobble@tw@
  \let\l@subsubsection\@gobble@tw@
  \let\l@paragraph\@gobble@tw@
 \fi}
\def\tocdepth@restore{%
 \let\l@section\l@section@saved
 \let\l@subsection\l@subsection@saved
 \let\l@subsubsection\l@subsubsection@saved
 \let\l@paragraph\l@paragraph@saved}
\newcommand{\hideMainFromTOC}{\addtocontents{toc}{\string\tocdepth@munge}}
% Resolve lane anchors before passing them to TikZ's key/coordinate parsers.
\renewcommand{\lanemove}[5][black!55]{%
 \ifnum\csname tn@lane@#2\endcsname=0
  \def\arxiv@anchor{east}\def\arxiv@outer{west}\def\arxiv@shift{-1.5pt}%
 \else
  \def\arxiv@anchor{west}\def\arxiv@outer{east}\def\arxiv@shift{1.5pt}%
 \fi
 \path let \p1=(#3.north),\p2=(#3.south) in
  node[lanemv] (mv#4) at (\x1,{\y1+\lanemvpos*(\lanedy*1cm-\y1+\y2)}) {#4};
 \draw[#1,line width=.5pt,shorten <=.5pt] (#2)--(mv#4);
 \draw[flow,#1,shorten >=.5pt] (mv#4)--(#3);
 \node[maprule,anchor=\arxiv@anchor,inner sep=1pt,xshift=\arxiv@shift]
  at (mv#4.\arxiv@outer) {#5};}
\makeatother
