import CertifiedGaps.Ring.Gap
import CertifiedGaps.Local.SpinHalf

/-!
# The spin-one-half Heisenberg chain in a staggered field

`H_L = ∑ⱼ Sⱼ · Sⱼ₊₁ - h ∑ⱼ (-1)ʲ Sᶻⱼ` on a periodic ring. The rotation `e^{iπSʸ}` on every other
site maps every bond to `-SˣSˣ + SʸSʸ - SᶻSᶻ` and the staggered field to the uniform field
`-h Sᶻ` (since `e^{iπSʸ} Sᶻ e^{-iπSʸ} = -Sᶻ`); on an even ring it is a unitary, so the spectrum
is unchanged. This file states the result for the rotated chain `model h`: a reflection-positive
ring with bond factors `Sˣ, iSʸ, Sᶻ` (`SpinHalf.P`) and on-site term `-h Sᶻ`. The physical chain
is in `StaggeredHeisenbergPhysical`.

Each point `p ∈ points` carries its field, its seed `(8, β₀)` and a rational chain certificate;
`points_valid` checks the five certificates by `decide`, and `gap` gives `Δ_L > log r / β₀` for
every even `L ≥ 8`. The seeds are certified in `models/heisenberg_staggered_field` (complete
spectra of the rings of `8` and `16` sites with rigorous eigenvalue enclosures); `seeds` is the
only `sorry`.
-/

open Matrix Real

namespace CertifiedGaps.StaggeredHeisenberg

open SpinHalf

/-- The rotated chain in the field `h` as a reflection-positive ring. -/
noncomputable def model (h : ℝ) : RPRing (Fin 2) (Fin 3) where
  C := P
  o := -h • P 2
  C_symm := P_symm
  o_symm := by
    rw [transpose_smul]
    congr 1
    ext i j; fin_cases i <;> fin_cases j <;> norm_num [P]

/-- A certified point: the staggered field, the seed inverse temperature `β₀` (the seed length is
`n₀ = 8` sites) and the chain certificate, whose first entries are the seed defects. -/
structure Point where
  /-- The staggered field. -/
  h : ℚ
  /-- The seed inverse temperature. -/
  β₀ : ℚ
  /-- The chain certificate. -/
  cert : ChainCertificate

/-- The five points of `models/heisenberg_staggered_field`, generated by
`lean/scripts/chain_certificate.jl` from the certified seed defects. -/
def points : List Point := [
  -- h = 1: bound log 413.4 / (21/4) ≈ 1.1475
  ⟨1, 21 / 4, {
    s := [6937e-7, 2254e-9, 1562e-14, 5636e-25, 6477e-46, 8394e-88, 141e-170, 3977e-339,
        3164e-674]
    t := [7327e-7, 108e-8, 2333e-15, 1089e-26, 2372e-49, 1126e-94, 2536e-185, 1287e-366,
        3313e-729]
    r := 4134e-1
    ε := 3164e-674 }⟩,
  -- h = 3/4: bound log 106.9 / (21/4) ≈ 0.8899
  ⟨3 / 4, 21 / 4, {
    s := [2343e-6, 3082e-8, 3324e-12, 2768e-20, 1603e-36, 515e-68, 5305e-134, 5629e-264,
        6338e-524]
    t := [3123e-6, 1989e-8, 7915e-13, 1253e-21, 3141e-39, 1974e-74, 7794e-145, 1215e-285,
        2953e-567]
    r := 1069e-1
    ε := 6338e-524 }⟩,
  -- h = 1/2: bound log 26.23 / (11/2) ≈ 0.5940
  ⟨1 / 2, 11 / 2, {
    s := [1075e-5, 5573e-7, 9615e-10, 2144e-15, 9381e-27, 1761e-49, 6203e-95, 7696e-186,
        1185e-367]
    t := [1116e-5, 2708e-7, 1474e-10, 4346e-17, 3778e-30, 2855e-56, 1631e-108, 5321e-213,
        5663e-422]
    r := 2623e-2
    ε := 1185e-367 }⟩,
  -- h = 7/20: bound log 9.035 / (23/4) ≈ 0.3828
  ⟨7 / 20, 23 / 4, {
    s := [3266e-5, 4883e-6, 6973e-8, 1087e-11, 2391e-19, 1144e-34, 2618e-65, 1371e-126,
        376e-248]
    t := [2744e-5, 1948e-6, 791e-8, 1254e-13, 3146e-23, 198e-41, 7841e-81, 123e-156, 3026e-311]
    r := 9035e-3
    ε := 376e-248 }⟩,
  -- h = 1/4: bound log 3.806 / (25/4) ≈ 0.2139
  ⟨1 / 4, 25 / 4, {
    s := [7987e-5, 2797e-5, 2248e-6, 1099e-8, 2431e-13, 1182e-22, 2795e-41, 1563e-78, 4886e-153]
    t := [4477e-5, 8125e-6, 1757e-7, 657e-10, 8665e-18, 1502e-31, 4513e-59, 4074e-114, 332e-223]
    r := 3806e-3
    ε := 4886e-153 }⟩]

/-- All five certificates are valid, checked by the kernel. -/
theorem points_valid : ∀ p ∈ points, p.cert.Valid := by decide +kernel

/-- Every seed inverse temperature is positive. -/
theorem points_β₀_pos : ∀ p ∈ points, 0 < p.β₀ := by decide +kernel

/-- The seeds: for every point, `P_s(8, β₀) ≥ 1 - εₛ` and `P_τ(16, β₀) ≥ 1 - εₜ`.
Certified in `models/heisenberg_staggered_field`. -/
theorem seeds : ∀ p ∈ points,
    1 - (p.cert.sAt 0 : ℝ) ≤ (model p.h).spatialPurity 8 p.β₀ ∧
      1 - (p.cert.tAt 0 : ℝ) ≤ (model p.h).thermalPurity 16 p.β₀ := by
  sorry

/-- **The rotated staggered-field chain.** At every point, every even ring of `L ≥ 8` sites has
a unique ground state and gap `Δ_L > log r / β₀`. -/
theorem gap {p : Point} (hp : p ∈ points) {L : ℕ} (hL : 8 ≤ L) (hLe : Even L) :
    GapGT ((model p.h).spectrum L) (log (p.cert.r : ℝ) / p.β₀) :=
  (model p.h).gapGT_of_chainCertificate (n₀ := 8) (by norm_num) (by decide)
    (by exact_mod_cast points_β₀_pos p hp) (points_valid p hp) ⟨rfl, rfl, rfl⟩ (seeds p hp).1
    (seeds p hp).2 hL hLe

end CertifiedGaps.StaggeredHeisenberg
