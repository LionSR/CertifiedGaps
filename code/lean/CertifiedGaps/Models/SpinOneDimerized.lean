import CertifiedGaps.Ring.Gap
import CertifiedGaps.Local.SpinOne
import CertifiedGaps.Local.CellSwap

/-!
# The dimerized spin-one Heisenberg chain

`H = ∑ⱼ (1 - δ) S₂ⱼ · S₂ⱼ₊₁ + (1 + δ) S₂ⱼ₊₁ · S₂ⱼ₊₂` on a periodic ring of `2L` spin-one sites,
as a ring of `L` cells (the weak pairs), in the Cartesian basis. With the real antisymmetric
`Gα = ε_α = i Sα` (`SpinOne.G`), `-S · S = ∑_α Gα ⊗ Gα`, so (`model δ`):

* the strong bond between cells is `-h = ∑_α Cα ⊗ (F Cα F)` with `Cα = √(1 + δ) (1 ⊗ Gα)` and
  `F` the swap of the cell;
* the weak pair is the on-site term `o = -(1 - δ) ∑_α Gα ⊗ Gα`, which commutes with `F`.

So it is a reflection-positive ring with internal reflection `F`, with no basis change. Each
point `p ∈ points` carries its dimerization, its seed `(2, β₀)` (cells) and a rational chain
certificate; `gap` gives `Δ_L > log r / β₀` for every even `L ≥ 2`. The seed is certified in
`models/spin1_dimerized` (complete spectra of the rings of `4` and `8` spins); `seeds` is the
only `sorry`. The `δ = 7/10` certificate of that directory uses an odd seed (`n₀ = 3` cells)
and is not covered here.
-/

open Matrix Real
open scoped Kronecker

namespace CertifiedGaps.SpinOneDimerized

open SpinOne

/-- The dimerized spin-one chain as a reflection-positive ring of weak pairs. -/
noncomputable def model (δ : ℝ) : RPRing (Fin 3 × Fin 3) (Fin 3) where
  C α := Real.sqrt (1 + δ) • (1 ⊗ₖ G α)
  o := -(1 - δ) • ∑ α, G α ⊗ₖ G α
  C_symm α := transpose_smul_eq_or _ (transpose_kronecker_eq_or (.inl transpose_one)
    (.inr (G_transpose α)))
  o_symm := by rw [transpose_smul, transpose_sum_kronecker_self G fun α ↦ .inr (G_transpose α)]
  refl := cellSwap
  refl_symm := cellSwap_transpose
  refl_sq := cellSwap_mul_cellSwap
  refl_o := cellSwap_conj_smul_sum_kronecker_self _ _

/-- A certified point: the dimerization, the seed inverse temperature `β₀` (the seed length is
`n₀ = 2` cells) and the chain certificate, whose first entries are the seed defects. -/
structure Point where
  /-- The dimerization. -/
  δ : ℚ
  /-- The seed inverse temperature. -/
  β₀ : ℚ
  /-- The chain certificate. -/
  cert : ChainCertificate

/-- The point of `models/spin1_dimerized` with an even seed, generated by
`lean/scripts/chain_certificate.jl` from the certified seed defects. -/
def points : List Point := [
  -- δ = 9/10: bound log 6.339 / (7/2) ≈ 0.5276
  ⟨9 / 10, 7 / 2, {
    s := [4972e-5, 1038e-5, 294e-6, 1857e-10, 6931e-17, 9608e-30, 1847e-55, 6823e-107, 9311e-210]
    t := [3206e-5, 3084e-6, 2108e-8, 8967e-13, 1609e-21, 5178e-39, 5363e-74, 5753e-144, 662e-283]
    r := 6339e-3
    ε := 9311e-210 }⟩]

/-- The certificate is valid, checked by the kernel. -/
theorem points_valid : ∀ p ∈ points, p.cert.Valid := by decide +kernel

/-- Every seed inverse temperature is positive. -/
theorem points_β₀_pos : ∀ p ∈ points, 0 < p.β₀ := by decide +kernel

/-- The seeds: for every point, `P_s(2, β₀) ≥ 1 - εₛ` and `P_τ(4, β₀) ≥ 1 - εₜ`.
Certified in `models/spin1_dimerized`. -/
theorem seeds : ∀ p ∈ points,
    1 - (p.cert.sAt 0 : ℝ) ≤ (model p.δ).spatialPurity 2 p.β₀ ∧
      1 - (p.cert.tAt 0 : ℝ) ≤ (model p.δ).thermalPurity 4 p.β₀ := by
  sorry

/-- **The dimerized spin-one chain.** At every point, every even ring of `L ≥ 2` cells has a
unique ground state and gap `Δ_L > log r / β₀`. -/
theorem gap {p : Point} (hp : p ∈ points) {L : ℕ} (hL : 2 ≤ L) (hLe : Even L) :
    GapGT ((model p.δ).spectrum L) (log (p.cert.r : ℝ) / p.β₀) :=
  (model p.δ).gapGT_of_chainCertificate (n₀ := 2) le_rfl (by decide)
    (by exact_mod_cast points_β₀_pos p hp) (points_valid p hp) ⟨rfl, rfl, rfl⟩ (seeds p hp).1
    (seeds p hp).2 hL hLe

end CertifiedGaps.SpinOneDimerized
