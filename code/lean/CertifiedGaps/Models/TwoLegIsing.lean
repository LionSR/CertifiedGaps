import CertifiedGaps.Ring.Gap
import CertifiedGaps.Local.Pauli

/-!
# The two-leg transverse-field Ising ladder

`H_L = -∑_{legs} ZᵢZⱼ - ∑_{rungs} ZᵢZⱼ - g ∑ᵢ Xᵢ` (Pauli matrices) on a periodic ring of `L`
rungs. It is a reflection-positive ring of rungs (`model g`) with cell space `Fin 2 × Fin 2`
(leg `a` ⊗ leg `b`), bond factors `Z ⊗ 1` and `1 ⊗ Z` (so `-h = ∑_{legs} Z ⊗ Z`), and the rung
and field as the on-site term `o = -Z ⊗ Z - g (X ⊗ 1 + 1 ⊗ X)`. No basis change is needed.

Each point `p ∈ points` carries its field, its seed `(4, β₀)` (rungs) and a rational chain
certificate; `gap` gives `Δ_L > log r / β₀` for every even `L ≥ 4`. The seeds are certified in
`models/two_leg_tfim` (complete spectra of the rings of `4` and `8` rungs with rigorous
eigenvalue enclosures); `seeds` is the only `sorry`.
-/

open Matrix Real
open scoped Kronecker

namespace CertifiedGaps.TwoLegIsing

/-- The two-leg Ising ladder in the transverse field `g` as a reflection-positive ring of rungs. -/
noncomputable def model (g : ℝ) : RPRing (Fin 2 × Fin 2) (Fin 2) where
  C := ![pauliZ ⊗ₖ 1, 1 ⊗ₖ pauliZ]
  o := -(pauliZ ⊗ₖ pauliZ) - g • (pauliX ⊗ₖ 1 + 1 ⊗ₖ pauliX)
  C_symm α := by
    left
    fin_cases α <;> simp [← kroneckerMap_transpose, pauliZ_transpose]
  o_symm := by
    simp [transpose_sub, transpose_add, ← kroneckerMap_transpose, pauliZ_transpose,
      pauliX_transpose]

/-- A certified point: the transverse field, the seed inverse temperature `β₀` (the seed length
is `n₀ = 4` rungs) and the chain certificate, whose first entries are the seed defects. -/
structure Point where
  /-- The transverse field. -/
  g : ℚ
  /-- The seed inverse temperature. -/
  β₀ : ℚ
  /-- The chain certificate. -/
  cert : ChainCertificate

/-- The point of `models/two_leg_tfim`, generated by `lean/scripts/chain_certificate.jl` from
the certified seed defects. -/
def points : List Point := [
  -- g = 3: bound log 2.585 / (3/2) ≈ 0.6332; εₛ ≈ 0.11240836635, εₜ ≈ 0.05161523886
  ⟨3, 3 / 2, {
    s := [1125e-4, 5736e-5, 1035e-5, 2422e-7, 1186e-10, 2814e-17, 1584e-30, 5019e-57, 5039e-110]
    t := [5162e-5, 1611e-5, 9601e-7, 2346e-9, 1158e-14, 2689e-25, 1447e-46, 4188e-89, 3508e-174]
    r := 2585e-3
    ε := 5039e-110 }⟩]

/-- The certificate is valid, checked by the kernel. -/
theorem points_valid : ∀ p ∈ points, p.cert.Valid := by decide +kernel

/-- Every seed inverse temperature is positive. -/
theorem points_β₀_pos : ∀ p ∈ points, 0 < p.β₀ := by decide +kernel

/-- The seeds: for every point, `P_s(4, β₀) ≥ 1 - εₛ` and `P_τ(8, β₀) ≥ 1 - εₜ`.
Certified in `models/two_leg_tfim`. -/
theorem seeds : ∀ p ∈ points,
    1 - (p.cert.sAt 0 : ℝ) ≤ (model p.g).spatialPurity 4 p.β₀ ∧
      1 - (p.cert.tAt 0 : ℝ) ≤ (model p.g).thermalPurity 8 p.β₀ := by
  sorry

/-- **The two-leg Ising ladder.** At every point, every even ring of `L ≥ 4` rungs has a unique
ground state and gap `Δ_L > log r / β₀`. -/
theorem gap {p : Point} (hp : p ∈ points) {L : ℕ} (hL : 4 ≤ L) (hLe : Even L) :
    GapGT ((model p.g).spectrum L) (log (p.cert.r : ℝ) / p.β₀) :=
  (model p.g).gapGT_of_chainCertificate (n₀ := 4) (by norm_num) (by decide)
    (by exact_mod_cast points_β₀_pos p hp) (points_valid p hp) ⟨rfl, rfl, rfl⟩ (seeds p hp).1
    (seeds p hp).2 hL hLe

end CertifiedGaps.TwoLegIsing
