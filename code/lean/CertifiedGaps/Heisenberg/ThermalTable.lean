import CertifiedGaps.Heisenberg.EnergyBound
import CertifiedGaps.Heisenberg.Seed36
import CertifiedGaps.Trace.Horner
import CertifiedGaps.Trace.Orbit
import CertifiedGaps.Trace.Poisson

/-!
# The thermal table at `b = 49/4` from the paper's integer totals

The hypothesis `TraceTable` of `Seed36.lean` (the shifted traces `e^{-bκn} Z_n(b)` and
`e^{-bκn} Z_n(b, P)` at `b = 49/4`, `n = 4, …, 12`, within `3 × 10⁻⁵` of the table) is reduced
here to a statement about integers: the integer algorithm of `thermal72.tex` (Appendix
"Thermal calculation at inverse temperature 49/4" of the spin-one paper) reproduces the
eighteen printed totals `W_{n,g}`.

## The integer algorithm, as Lean definitions

* `thermalMatrix n g = (32 - 3n) I - 2 H_n(g)`, the integer matrix `D = 32 R` of
  eq. (thermal72-matrix), built from the integer ring `ringZ n g` (the `S^z`-basis exchange
  `exchangeZ`, with `twistedExchangeZ` on the closing bond for `g = 1`).
* `thermalCoeff j = ⌊2⁵⁵ p_j⌋` with the conditioned Poisson weights `p_j = poissonWeight 98 280 j`
  (eq. (thermal72-coefficients)); `thermalColumn n g ρ = hornerFloor D 32 c ρ 280`, the column
  `X ← ⌊D X / 32⌋ + c_j e_ρ` for `j = 280, …, 0` (eq. (thermal72-horner)).
* `thermalRep w`: the lexicographically least word (letters `-1 < 0 < 1`, compared through the
  base-3 code `wordCode`) among the cyclic shifts and reversals of `w` (positive weight), of `-w`
  (negative weight), or of both (zero weight). Its fibers are the paper's multiplicities: twice
  the orbit size for positive weight, the orbit size including negation for zero weight.
* `hornerTotal n g = ∑_ρ ν_ρ ∑_w X_ρ(w)²` over the image of `thermalRep`, `ν_ρ` the fiber size
  (eq. (thermal72-total)), and `paperTotal n g` the printed table. `HornerTotals` says that the
  two agree for every `n ∈ tableLengths` and both twists.

## The proof

* The energy bounds `-(3n/2) ≤ H ≤ n` (`hamZ_bounds`, from `Heisenberg/EnergyBound.lean`
  through the unitary `szFrame`) make `R = D/32` a contraction for `3 ≤ n ≤ 12`
  (`abs_qform_thermalR_le`, `thermalMatrix_contraction`).
* `F = e^{-(b/2)(3n/2 + H)} = e^{98 (R - 1)}` (`gibbsHalf_hamZ`); the Horner rounding error
  `281 (d_n + 1)` (`hornerFloor_error_nsq`) and the Poisson truncation `2⁻⁸⁴`
  (`nsq_exp_sub_poisson_98_280`), scaled by `Q = 2⁵⁵`, give `‖X_ρ - Q F e_ρ‖ ≤ E_n`
  (`thermalColumn_error`).
* The shift, the reversal and the negation are column symmetries of `H_n(g)`
  (`isColumnSymmetry_wordGens`; for the twisted ring the shift carries the sign `(-1)^{w₀}`, the
  paper's `G_k` one step at a time), and every representative is an image of its word
  (`exists_closure_thermalRep`), so `gibbsTrace_enclosure_of_rep` applies
  (`shiftedTrace_mem`).
* The eighteen rational inequalities `L ≥ C - 3 × 10⁻⁵`, `U ≤ C + 3 × 10⁻⁵` are checked by
  `decide +kernel` (`thermalChecks`), as are the paper's strict forms with margin `13/10⁶`
  (`thermalMargins`).

## Main results

* `traceTable_of_hornerTotals : HornerTotals → TraceTable`.
* `gap_thirtysix_of_hornerTotals_mps`: the gap for every even `L ≥ 36` from the integer totals
  and the integer trial-state inequality.

## Comparison with the paper

* The floors of one Horner step are bounded on the whole space of dimension `3ⁿ`, not on a
  weight block; the paper's constant `d_n = ⌊√(3ⁿ)⌋ + 1` is the same.
* The signed shift `G_k ∘ (shift by k)` is generated by the one-step shift with the one-site
  sign at site `0`; the reversal fixes the seam bond; global negation needs no sign.
* `|√W - Q ‖F‖_F| ≤ √(3ⁿ) E_n ≤ ℰ_n` is used in the form `3ⁿ E_n² ≤ ℰ_n²`.
* The paper's argument that the recursion is exact in signed 64-bit integers is not needed: the
  Lean recursion runs in `ℤ`, and `HornerTotals` is a statement about exact integers.
* `hornerTotal` is computable but not meant for compiled evaluation (`hornerFloor` represents
  vectors as functions, so `#eval` is exponential in the number of steps); the totals are
  computed by an external program (`models/spin1`) and enter as the hypothesis.
-/

open Finset Matrix
open scoped Finset Nat
open CertifiedGaps.Spectral (nsq qform nsq_nonneg nsq_smul nsq_mulVec_of_unitary qform_mulVec
  qform_sub_left qform_one qform_smul_left qform_add_left)

namespace CertifiedGaps.SpinOneHeisenberg

open Trace

/-! ### The integer algorithm -/

/-- The closing bond of the two rings in the `S^z` basis: `g = 0` untwisted, `g = 1` twisted by
the `π` rotation about `z`. -/
def seamBond : Fin 2 → Matrix (Fin 3 × Fin 3) (Fin 3 × Fin 3) ℤ := ![exchangeZ, twistedExchangeZ]

/-- The integer ring Hamiltonian `H_n(g)` in the `S^z` basis. -/
def ringZ (n : ℕ) (g : Fin 2) : Matrix (Fin n → Fin 3) (Fin n → Fin 3) ℤ :=
  twistedRingHamiltonian exchangeZ (seamBond g) n

/-- The integer matrix `D = 32 R = (32 - 3n) I - 2 H_n(g)` of eq. (thermal72-matrix). -/
def thermalMatrix (n : ℕ) (g : Fin 2) : Matrix (Fin n → Fin 3) (Fin n → Fin 3) ℤ :=
  (32 - 3 * (n : ℤ)) • (1 : Matrix (Fin n → Fin 3) (Fin n → Fin 3) ℤ) - 2 • ringZ n g

/-- The fixed-point scale `Q = 2⁵⁵`. -/
def thermalScale : ℚ := 2 ^ 55

/-- The integer Horner coefficients `c_j = ⌊Q p_j⌋` with the Poisson weights `p_j` of mean `98`
conditioned to `j ≤ 280` (eq. (thermal72-coefficients)). -/
def thermalCoeff (j : ℕ) : ℤ := ⌊thermalScale * poissonWeight 98 280 j⌋

/-- The integer column `X_ρ` of eq. (thermal72-horner): `X ← ⌊D X / 32⌋ + c_j e_ρ` for
`j = 280, …, 0`, from `X = 0`. -/
def thermalColumn (n : ℕ) (g : Fin 2) (ρ : Fin n → Fin 3) : (Fin n → Fin 3) → ℤ :=
  hornerFloor (thermalMatrix n g) 32 thermalCoeff ρ 280

/-! ### Words and representatives -/

/-- The total weight `∑ᵢ wᵢ` of a word (letters `m = i - 1`). -/
def wordWeight {n : ℕ} (w : Fin n → Fin 3) : ℤ := ∑ i, mz (w i)

/-- The base-3 code of a word, first letter most significant: the lexicographic order of words
(with `-1 < 0 < 1`) is the order of their codes. -/
def wordCode {n : ℕ} (w : Fin n → Fin 3) : ℕ := ∑ i : Fin n, (w i : ℕ) * 3 ^ (n - 1 - i)

/-- The cyclic shift `w ↦ (w₁, …, w_{n-1}, w₀)`. -/
def rotWord (n : ℕ) : Equiv.Perm (Fin n → Fin 3) := relabel (finRotate n)

/-- The reversal `w ↦ (w_{n-1}, …, w₀)`. -/
def revWord (n : ℕ) : Equiv.Perm (Fin n → Fin 3) := relabel Fin.revPerm

/-- The digit negation `w ↦ -w`. -/
def negWord (n : ℕ) : Equiv.Perm (Fin n → Fin 3) := onsite Fin.revPerm

/-- The cyclic shifts and their reversals. -/
def dihedralPerms (n : ℕ) : List (Equiv.Perm (Fin n → Fin 3)) :=
  (List.range n).flatMap fun k ↦ [rotWord n ^ k, revWord n * rotWord n ^ k]

/-- The words among which the representative of `w` is chosen: the shifts and reversals of `w`
if its weight is positive, those of `-w` if it is negative, and both if it is zero. -/
def orbitWords {n : ℕ} (w : Fin n → Fin 3) : List (Fin n → Fin 3) :=
  (if 0 ≤ wordWeight w then (dihedralPerms n).map (· w) else []) ++
    (if wordWeight w ≤ 0 then (dihedralPerms n).map (· (negWord n w)) else [])

/-- One step of the search for the least code: keep the pair `(code, word)` with the smaller
code. The code is stored with the word so that compiled evaluation does not recompute it. -/
def lexMinStep {n : ℕ} (a : ℕ × (Fin n → Fin 3)) (b : Fin n → Fin 3) : ℕ × (Fin n → Fin 3) :=
  if wordCode b < a.1 then (wordCode b, b) else a

/-- The representative of a word: the lexicographically least word of its orbit, taken in the
nonnegative-weight half (§"Representative columns"). -/
def thermalRep {n : ℕ} (w : Fin n → Fin 3) : Fin n → Fin 3 :=
  let w₀ := if 0 ≤ wordWeight w then w else negWord n w
  ((orbitWords w).foldl lexMinStep (wordCode w₀, w₀)).2

/-- **The integer total** `W_{n,g} = ∑_ρ ν_ρ ∑_w X_ρ(w)²` of eq. (thermal72-total): `ρ` runs
over the representatives and `ν_ρ` is the number of words represented by `ρ`. -/
def hornerTotal (n : ℕ) (g : Fin 2) : ℤ :=
  ∑ ρ ∈ univ.image (thermalRep (n := n)),
    (#{x | thermalRep x = ρ} : ℤ) * ∑ w, thermalColumn n g ρ w ^ 2

/-- The totals `W_{n,I}` (`g = 0`) and `W_{n,P}` (`g = 1`) printed in `thermal72.tex`. -/
def paperTotal : ℕ → Fin 2 → ℕ
  | 4 => ![1298092848946206529211955779616040, 683496640248050713756440676071]
  | 5 => ![9095379218684502088743241789, 9205948219074287936685289758037]
  | 6 => ![11971284263768914176431179720622, 266573596119930013833919176645]
  | 7 => ![15044150708248976451784593468, 534330762492192297990602166370]
  | 8 => ![386135473475360677201628357188, 42459883501386986922766507327]
  | 9 => ![4866417737994347551816846903, 37716485750353424806876104310]
  | 10 => ![19772960374215472827775892486, 5030484777222468978572235564]
  | 11 => ![841347687722481981930750335, 2928767918985354021900689432]
  | 12 => ![1266666171463993322695232916, 524785463625387865619045258]
  | _ => ![0, 0]

/-- **The hypothesis**: the integer algorithm reproduces the printed totals. -/
def HornerTotals : Prop :=
  ∀ n ∈ tableLengths, ∀ g : Fin 2, hornerTotal n g = paperTotal n g

/-! ### The Hamiltonians over `ℂ` -/

/-- The ring Hamiltonian `H_n(g)` over `ℂ`. -/
def hamZ (n : ℕ) (g : Fin 2) : Matrix (Fin n → Fin 3) (Fin n → Fin 3) ℂ :=
  (ringZ n g).map ((↑) : ℤ → ℂ)

/-- The twisted exchange in the `S^z` basis is a symmetric integer matrix. -/
theorem twistedExchangeZ_transpose : twistedExchangeZᵀ = twistedExchangeZ := by
  have h : ∀ p q : Fin 3 × Fin 3, twistedExchangeZ q p = twistedExchangeZ p q := by
    intro ⟨a, b⟩ ⟨c, d⟩
    fin_cases a <;> fin_cases b <;> fin_cases c <;> fin_cases d <;> rfl
  ext p q
  exact h p q

/-- Both closing bonds are symmetric integer matrices. -/
theorem seamBond_transpose (g : Fin 2) : (seamBond g)ᵀ = seamBond g := by
  fin_cases g
  · exact exchangeZ_transpose
  · exact twistedExchangeZ_transpose

/-- `H_n(g)` over `ℂ` is the generic twisted ring of the cast bonds. -/
theorem hamZ_eq (n : ℕ) (g : Fin 2) :
    hamZ n g =
      twistedRingHamiltonian (exchangeZ.map (↑)) ((seamBond g).map ((↑) : ℤ → ℂ)) n :=
  twistedRingHamiltonian_map _ _ _ (Int.castAddHom ℂ)

/-- `H_n(g)` is Hermitian. -/
theorem hamZ_isHermitian (n : ℕ) (g : Fin 2) : (hamZ n g).IsHermitian := by
  rw [hamZ_eq]
  exact twistedRingHamiltonian_isHermitian (isHermitian_map_intCast exchangeZ_transpose)
    (isHermitian_map_intCast (seamBond_transpose g)) n

/-- The untwisted ring is `hamiltonianZ`. -/
theorem hamZ_zero (n : ℕ) : hamZ n 0 = hamiltonianZ n := by
  rw [hamZ_eq]
  exact twistedRingHamiltonian_self _ n

/-- The twisted ring is `twistedHamiltonianZ`. -/
theorem hamZ_one (n : ℕ) : hamZ n 1 = twistedHamiltonianZ n := by
  rw [hamZ_eq]
  rfl

/-- `Z_n(β) = Tr e^{-β H_n(I)}`. -/
theorem gibbsTrace_hamZ_zero {n : ℕ} (hn : n ≠ 1) (β : ℝ) :
    gibbsTrace (hamZ n 0) β = partitionFunction n β := by
  rw [hamZ_zero, partitionFunction_eq_partitionFunctionZ hn]
  rfl

/-- `Z_n(β, P) = Tr e^{-β H_n(P)}`. -/
theorem gibbsTrace_hamZ_one {n : ℕ} (hn : n ≠ 1) (β : ℝ) :
    gibbsTrace (hamZ n 1) β = twistedPartitionFunction n β := by
  rw [hamZ_one, twistedPartitionFunction_eq_gibbsTrace_twistedHamiltonianZ hn]

/-- **Energy bounds in the `S^z` basis**: `-(3n/2) ≤ H_n(g) ≤ n`, transported from the Cartesian
basis (`Heisenberg/EnergyBound.lean`) by the unitary `szFrame`. -/
theorem hamZ_bounds {n : ℕ} (hn : 3 ≤ n) (g : Fin 2) (x : (Fin n → Fin 3) → ℂ) :
    -(3 * n / 2) * nsq x ≤ qform (hamZ n g) x ∧ qform (hamZ n g) x ≤ n * nsq x := by
  have hU := szFrame_conjTranspose_mul_self n
  have hnorm : nsq (szFrame n *ᵥ x) = nsq x := nsq_mulVec_of_unitary hU x
  fin_cases g
  · have h : hamZ n 0 = (szFrame n)ᴴ * hamiltonian n * szFrame n := by
      rw [hamZ_zero, conj_hamiltonian (by omega)]
    simp only [Fin.zero_eta, Fin.isValue]
    rw [h, ← qform_mulVec, ← hnorm]
    exact ⟨le_qform_hamiltonian hn _, qform_hamiltonian_le (by omega) _⟩
  · have h : hamZ n 1 = (szFrame n)ᴴ * twistedHamiltonian n * szFrame n := by
      rw [hamZ_one, conj_twistedHamiltonian (by omega)]
    simp only [Fin.mk_one, Fin.isValue]
    rw [h, ← qform_mulVec, ← hnorm]
    exact ⟨le_qform_twistedHamiltonian hn _, qform_twistedHamiltonian_le (by omega) _⟩

/-! ### The contraction `R = D / 32` -/

/-- The complex matrix `R = D / 32`. -/
noncomputable def thermalR (n : ℕ) (g : Fin 2) : Matrix (Fin n → Fin 3) (Fin n → Fin 3) ℂ :=
  ((32 : ℕ) : ℂ)⁻¹ • (thermalMatrix n g).map ((↑) : ℤ → ℂ)

/-- The cast of `D` is `(32 - 3n) - 2 H`. -/
theorem thermalMatrix_map (n : ℕ) (g : Fin 2) :
    (thermalMatrix n g).map ((↑) : ℤ → ℂ) =
      ((32 - 3 * n : ℝ) : ℂ) • (1 : Matrix (Fin n → Fin 3) (Fin n → Fin 3) ℂ) -
        (2 : ℂ) • hamZ n g := by
  ext σ τ
  simp only [thermalMatrix, hamZ, Matrix.map_apply, Matrix.sub_apply, Matrix.smul_apply,
    Matrix.one_apply]
  split_ifs <;> simp only [nsmul_eq_mul, smul_eq_mul] <;> push_cast <;> ring

/-- `R = I - ((3/2) n I + H) / 16` (eq. (thermal72-matrix)). -/
theorem thermalR_eq (n : ℕ) (g : Fin 2) :
    thermalR n g = 1 - ((1 / 16 : ℝ) : ℂ) • (hamZ n g + ((3 * n / 2 : ℝ) : ℂ) • 1) := by
  rw [thermalR, thermalMatrix_map]
  push_cast
  module

/-- `R` is Hermitian. -/
theorem thermalR_isHermitian (n : ℕ) (g : Fin 2) : (thermalR n g).IsHermitian := by
  rw [thermalR_eq]
  exact isHermitian_one.sub (((hamZ_isHermitian n g).add
    (isHermitian_one.smul (Complex.conj_ofReal _))).smul (Complex.conj_ofReal _))

/-- `qform_smul_left` with the scalar written through `Complex.ofReal`. -/
theorem qform_ofReal_smul {m : Type*} [Fintype m] (r : ℝ) (A : Matrix m m ℂ) (x : m → ℂ) :
    qform ((r : ℂ) • A) x = r * qform A x :=
  qform_smul_left r A x

/-- `R` is a contraction for `3 ≤ n ≤ 12`: `spec R ⊆ [1 - 5n/32, 1] ⊆ [-1, 1]`. -/
theorem abs_qform_thermalR_le {n : ℕ} (h3 : 3 ≤ n) (h12 : n ≤ 12) (g : Fin 2)
    (x : (Fin n → Fin 3) → ℂ) : |qform (thermalR n g) x| ≤ nsq x := by
  obtain ⟨hlo, hhi⟩ := hamZ_bounds h3 g x
  have hq : qform (thermalR n g) x =
      nsq x - 1 / 16 * (qform (hamZ n g) x + 3 * n / 2 * nsq x) := by
    rw [thermalR_eq, qform_sub_left, qform_one, qform_ofReal_smul, qform_add_left,
      qform_ofReal_smul, qform_one]
  have hx := nsq_nonneg x
  have hn : (n : ℝ) ≤ 12 := by exact_mod_cast h12
  rw [hq, abs_le]
  constructor <;> nlinarith

/-- `D = 32 R` is a scaled contraction, the hypothesis of the Horner error bound. -/
theorem thermalMatrix_contraction {n : ℕ} (h3 : 3 ≤ n) (h12 : n ≤ 12) (g : Fin 2) :
    IsScaledContraction (thermalMatrix n g) 32 := by
  refine IsScaledContraction.of_complex fun v ↦ ?_
  have hR := thermalR_isHermitian n g
  have hD : (thermalMatrix n g).map ((↑) : ℤ → ℂ) = ((32 : ℕ) : ℂ) • thermalR n g := by
    rw [thermalR, smul_smul, mul_inv_cancel₀ (by norm_num), one_smul]
  have hRv : nsq (thermalR n g *ᵥ v) ≤ 1 ^ 2 * nsq v := by
    conv_lhs => rw [← Spectral.hermFun_id hR]
    exact Spectral.nsq_hermFun_mulVec_le hR id
      (Spectral.abs_eigenvalues_le_one_of_qform hR (abs_qform_thermalR_le h3 h12 g)) v
  rw [hD, Matrix.smul_mulVec, nsq_smul]
  have h32 : ‖((32 : ℕ) : ℂ)‖ = (32 : ℕ) := by simp
  rw [h32]
  nlinarith [nsq_nonneg (thermalR n g *ᵥ v)]

/-- The half-step factor is the Poisson exponential: `F = e^{-(b/2)((3/2) n + H)} = e^{98(R - 1)}`
at `b = 49/4`. -/
theorem gibbsHalf_hamZ (n : ℕ) (g : Fin 2) :
    gibbsHalf (hamZ n g) (49 / 4) (3 * n / 2) =
      NormedSpace.exp ((98 : ℂ) • (thermalR n g - 1)) := by
  rw [gibbsHalf, thermalR_eq]
  congr 1
  push_cast
  module

/-! ### The column error -/

/-- The paper's `d_n = ⌊√(3ⁿ)⌋ + 1`, an integer bound on `√(3ⁿ)`. -/
def thermalDim (n : ℕ) : ℕ := Nat.sqrt (3 ^ n) + 1

/-- The column error `E_n = 281 (d_n + 1) + 1` (eq. (thermal72-errors)). -/
def columnError (n : ℕ) : ℕ := 281 * (thermalDim n + 1) + 1

/-- The Frobenius error `ℰ_n = d_n E_n`. -/
def frobeniusError (n : ℕ) : ℕ := thermalDim n * columnError n

/-- `3ⁿ < d_n²`, from `d_n = ⌊√(3ⁿ)⌋ + 1`. -/
theorem three_pow_lt_thermalDim_sq (n : ℕ) : 3 ^ n < thermalDim n ^ 2 :=
  Nat.lt_succ_sqrt' _

/-- There are `3ⁿ` words. -/
theorem card_words (n : ℕ) : Fintype.card (Fin n → Fin 3) = 3 ^ n := by simp

/-- `√(3ⁿ) ≤ d_n`: the floor error of one Horner step. -/
theorem sqrt_card_le_thermalDim (n : ℕ) :
    Real.sqrt (Fintype.card (Fin n → Fin 3)) ≤ thermalDim n := by
  rw [card_words, Real.sqrt_le_left (by positivity)]
  exact_mod_cast (three_pow_lt_thermalDim_sq n).le

/-- **The column error** (eq. (thermal72-column-error)): `‖X_ρ - Q F e_ρ‖ ≤ E_n`. The Horner
recursion is within `281 (d_n + 1)` of `Q ∑ p_j R^j e_ρ` (`hornerFloor_error_nsq`), and the
Poisson polynomial is within `2⁻⁸⁴` of `F` (`nsq_exp_sub_poisson_98_280`), which `Q = 2⁵⁵`
scales to less than `1`. -/
theorem thermalColumn_error {n : ℕ} (h3 : 3 ≤ n) (h12 : n ≤ 12) (g : Fin 2)
    (ρ : Fin n → Fin 3) :
    nsq ((fun w ↦ (thermalColumn n g ρ w : ℂ)) - ((thermalScale : ℝ) : ℂ) •
      (gibbsHalf (hamZ n g) (49 / 4) (3 * n / 2) *ᵥ Pi.single ρ 1)) ≤
      (columnError n : ℝ) ^ 2 := by
  set R := thermalR n g with hRdef
  have hR := thermalR_isHermitian n g
  have hspec := Spectral.abs_eigenvalues_le_one_of_qform hR (abs_qform_thermalR_le h3 h12 g)
  set e : (Fin n → Fin 3) → ℂ := Pi.single ρ 1
  set P := ∑ j ∈ range 281, (poissonWeight 98 280 j : ℂ) • R ^ j with hP
  set Q : ℝ := (thermalScale : ℝ) with hQ
  -- The Horner recursion against `Q P e`.
  have hH := hornerFloor_error_nsq (by norm_num) (thermalMatrix_contraction h3 h12 g)
    (sqrt_card_le_thermalDim n) ρ (c := thermalCoeff)
    (a := fun j ↦ ((thermalScale * poissonWeight 98 280 j : ℚ) : ℝ)) 280
    (fun j _ ↦ by rw [thermalCoeff, ← Rat.floor_cast (α := ℝ)]; exact abs_floor_sub_le_one _)
  have hpoly : (∑ j ∈ range (280 + 1),
      (((thermalScale * poissonWeight 98 280 j : ℚ) : ℝ) : ℂ) •
        (((32 : ℕ) : ℂ)⁻¹ • (thermalMatrix n g).map ((↑) : ℤ → ℂ)) ^ j) = (Q : ℂ) • P := by
    rw [hP, Finset.smul_sum]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    rw [smul_smul, hQ, hRdef, thermalR]
    push_cast
    rfl
  rw [hpoly] at hH
  -- The Poisson truncation.
  have hF := nsq_exp_sub_poisson_98_280 hR hspec e
  have he : nsq e = 1 := by
    rw [Spectral.nsq_eq_sum, Finset.sum_eq_single ρ (fun b _ hb ↦ by simp [e, hb]) (by simp)]
    simp [e]
  rw [he, mul_one] at hF
  rw [gibbsHalf_hamZ]
  have hsplit : (fun w ↦ (thermalColumn n g ρ w : ℂ)) -
      (Q : ℂ) • (NormedSpace.exp ((98 : ℂ) • (R - 1)) *ᵥ e) =
      (fun i ↦ (thermalColumn n g ρ i : ℂ) - (((Q : ℂ) • P) *ᵥ e) i) +
        (-(Q : ℂ)) • ((NormedSpace.exp ((98 : ℂ) • (R - 1)) - P) *ᵥ e) := by
    ext i
    simp only [Pi.sub_apply, Pi.add_apply, Pi.smul_apply, smul_eq_mul, Matrix.smul_mulVec,
      Matrix.sub_mulVec]
    ring
  have hQ0 : 0 ≤ Q := by rw [hQ, thermalScale]; positivity
  have hQ2 : nsq ((-(Q : ℂ)) • ((NormedSpace.exp ((98 : ℂ) • (R - 1)) - P) *ᵥ e)) ≤
      (Q * (1 / 2 ^ 84)) ^ 2 := by
    rw [nsq_smul, norm_neg, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hQ0, mul_pow]
    exact mul_le_mul_of_nonneg_left hF (by positivity)
  have hd0 : (0 : ℝ) ≤ thermalDim n := Nat.cast_nonneg _
  have hH' : nsq (fun i ↦ (thermalColumn n g ρ i : ℂ) - (((Q : ℂ) • P) *ᵥ e) i) ≤
      (281 * ((thermalDim n : ℝ) + 1)) ^ 2 := by
    have h281 : ((280 : ℕ) : ℝ) + 1 = 281 := by norm_num
    rw [h281] at hH
    exact hH
  rw [hsplit]
  refine (nsq_add_le_sq (a := 281 * ((thermalDim n : ℝ) + 1)) (b := Q * (1 / 2 ^ 84))
    (by positivity) (by positivity) hH' hQ2).trans ?_
  have hQv : Q * (1 / 2 ^ 84) ≤ 1 := by rw [hQ, thermalScale]; norm_num
  rw [columnError]
  push_cast
  gcongr

/-! ### Symmetries and representatives -/

/-- The signs `(-1)^m` of the gauge that moves the seam of the twisted ring. -/
def zSign : Fin 3 → ℤ := ![-1, 1, -1]

/-- The gauge signs square to one. -/
theorem zSign_mul_self (a : Fin 3) : zSign a * zSign a = 1 := by fin_cases a <;> rfl

/-- The gauge on the second site of a bond turns the plain exchange into the twisted one. -/
theorem gauge_right (a b c e : Fin 3) :
    twistedExchangeZ (a, b) (c, e) * zSign e = zSign b * exchangeZ (a, b) (c, e) := by
  revert a b c e; decide

/-- The gauge on the first site of a bond turns the twisted exchange into the plain one. -/
theorem gauge_left (a b c e : Fin 3) :
    exchangeZ (a, b) (c, e) * zSign c = zSign a * twistedExchangeZ (a, b) (c, e) := by
  revert a b c e; decide

/-- Both exchanges are symmetric under swapping the two sites. -/
theorem seamBond_swap (g : Fin 2) : (seamBond g).submatrix Prod.swap Prod.swap = seamBond g := by
  have h : ∀ g : Fin 2, ∀ a b c e : Fin 3, seamBond g (b, a) (e, c) = seamBond g (a, b) (c, e) := by
    decide
  ext ⟨a, b⟩ ⟨c, e⟩
  exact h g a b c e

/-- Both exchanges are invariant under the negation `m ↦ -m` on both sites. -/
theorem seamBond_neg (g : Fin 2) :
    (seamBond g).submatrix (Prod.map Fin.revPerm Fin.revPerm) (Prod.map Fin.revPerm Fin.revPerm) =
      seamBond g := by
  have h : ∀ g : Fin 2, ∀ a b c e : Fin 3,
      seamBond g (a.rev, b.rev) (c.rev, e.rev) = seamBond g (a, b) (c, e) := by
    decide
  ext ⟨a, b⟩ ⟨c, e⟩
  exact h g a b c e

/-- The three generators of the orbits. -/
def wordGens (n : ℕ) : Set (Equiv.Perm (Fin n → Fin 3)) := {rotWord n, revWord n, negWord n}

/-- The signed shift, the reversal and the negation are column symmetries of `H_n(g)`. -/
theorem isColumnSymmetry_wordGens {n : ℕ} (hn : 2 ≤ n) (g : Fin 2) :
    ∀ e ∈ wordGens n, IsColumnSymmetry (hamZ n g) e := by
  have hint : ∀ e ∈ wordGens n, ∃ u : (Fin n → Fin 3) → ℤ, (∀ σ, |u σ| = 1) ∧
      Intertwines e u (ringZ n g) (ringZ n g) := by
    intro e he
    rcases he with rfl | rfl | rfl
    · fin_cases g
      · exact ⟨_, fun _ ↦ abs_one, intertwines_ring_rotate (by omega) exchangeZ⟩
      · refine ⟨_, fun σ ↦ ?_, intertwines_twisted_rotate hn zSign zSign_mul_self
          (Bc := twistedExchangeZ) (fun a b c e ↦ gauge_right a b c e)
          (fun a b c e ↦ gauge_left a b c e)⟩
        generalize σ _ = a
        fin_cases a <;> rfl
    · exact ⟨_, fun _ ↦ abs_one, intertwines_twisted_reverse (by omega) (seamBond_swap 0)
        (seamBond_swap g)⟩
    · exact ⟨_, fun _ ↦ abs_one, intertwines_twisted_onsite _ (seamBond_neg 0) (seamBond_neg g)⟩
  intro e he
  obtain ⟨u, hu, h⟩ := hint e he
  exact IsColumnSymmetry.of_int hu h

/-- The search for the least code returns one of the words searched. -/
theorem foldl_lexMinStep_mem {n : ℕ} (l : List (Fin n → Fin 3)) (a : ℕ × (Fin n → Fin 3)) :
    (l.foldl lexMinStep a).2 ∈ a.2 :: l := by
  induction l generalizing a with
  | nil => simp
  | cons b l ih =>
    rw [List.foldl_cons]
    rcases List.mem_cons.1 (ih (lexMinStep a b)) with h | h
    · rw [h]
      unfold lexMinStep
      split_ifs <;> simp
    · exact List.mem_cons_of_mem _ (List.mem_cons_of_mem _ h)

/-- The shifts and reversals are generated by `wordGens`. -/
theorem dihedralPerms_mem_closure {n : ℕ} {p : Equiv.Perm (Fin n → Fin 3)}
    (hp : p ∈ dihedralPerms n) : p ∈ Submonoid.closure (wordGens n) := by
  have hrot : rotWord n ∈ Submonoid.closure (wordGens n) :=
    Submonoid.subset_closure (by simp [wordGens])
  have hrev : revWord n ∈ Submonoid.closure (wordGens n) :=
    Submonoid.subset_closure (by simp [wordGens])
  simp only [dihedralPerms, List.mem_flatMap, List.mem_range, List.mem_cons,
    List.not_mem_nil, or_false] at hp
  obtain ⟨k, -, rfl | rfl⟩ := hp
  · exact Submonoid.pow_mem _ hrot k
  · exact Submonoid.mul_mem _ hrev (Submonoid.pow_mem _ hrot k)

/-- Every representative is the image of its word under shifts, reversals and negations. -/
theorem exists_closure_thermalRep {n : ℕ} (w : Fin n → Fin 3) :
    ∃ p ∈ Submonoid.closure (wordGens n), p w = thermalRep w := by
  have hneg : negWord n ∈ Submonoid.closure (wordGens n) :=
    Submonoid.subset_closure (by simp [wordGens])
  set w₀ := if 0 ≤ wordWeight w then w else negWord n w with hw₀
  have hrep : thermalRep w = ((orbitWords w).foldl lexMinStep (wordCode w₀, w₀)).2 := rfl
  have hmem := foldl_lexMinStep_mem (orbitWords w) (wordCode w₀, w₀)
  rw [← hrep] at hmem
  generalize thermalRep w = x at hmem ⊢
  rcases List.mem_cons.1 hmem with h | h
  · rw [h, hw₀]
    split_ifs
    · exact ⟨1, Submonoid.one_mem _, rfl⟩
    · exact ⟨negWord n, hneg, rfl⟩
  · simp only [orbitWords, List.mem_append] at h
    rcases h with h | h
    · split_ifs at h
      · obtain ⟨p, hp, rfl⟩ := List.mem_map.1 h
        exact ⟨p, dihedralPerms_mem_closure hp, rfl⟩
      · exact absurd h List.not_mem_nil
    · split_ifs at h
      · obtain ⟨p, hp, rfl⟩ := List.mem_map.1 h
        exact ⟨p * negWord n, Submonoid.mul_mem _ (dihedralPerms_mem_closure hp) hneg, rfl⟩
      · exact absurd h List.not_mem_nil

/-! ### The rational enclosure -/

/-- `x_n = b n (3/2 - a)` at `b = 49/4`, `a = κ` (eq. (thermal72-trace)). -/
def thermalX (n : ℕ) : ℚ := 49 / 4 * n * (3 / 2 - kappa)

/-- The Taylor sum `s_n = ∑_{j ≤ 100} x_n^j / j!`. -/
def taylorS (n : ℕ) : ℚ := ∑ j ∈ range 101, thermalX n ^ j / j !

/-- The Taylor remainder bound `t_n = x_n^100 / 100!`. -/
def taylorT (n : ℕ) : ℚ := thermalX n ^ 100 / 100 !

/-- The lower endpoint `L = s_n max(0, r - ℰ_n)² / Q²` with `r = ⌊√W⌋`
(eq. (thermal72-enclosure)). -/
def thermalLower (n W : ℕ) : ℚ :=
  taylorS n * max 0 ((Nat.sqrt W : ℚ) - frobeniusError n) ^ 2 / thermalScale ^ 2

/-- The upper endpoint `U = (s_n + t_n)(r + 1 + ℰ_n)² / Q²`. -/
def thermalUpper (n W : ℕ) : ℚ :=
  (taylorS n + taylorT n) * ((Nat.sqrt W : ℚ) + 1 + frobeniusError n) ^ 2 / thermalScale ^ 2

/-- `0 ≤ x_n < 15` for `n ≤ 12`, the range of the Taylor enclosure. -/
theorem thermalX_mem {n : ℕ} (h12 : n ≤ 12) : 0 ≤ (thermalX n : ℝ) ∧ (thermalX n : ℝ) < 15 := by
  have hn : (n : ℝ) ≤ 12 := by exact_mod_cast h12
  have hn0 : (0 : ℝ) ≤ n := Nat.cast_nonneg n
  simp only [thermalX, kappa]
  push_cast
  constructor <;> nlinarith

/-- **The enclosure of one shifted trace from its integer total.** If the integer algorithm gives
the total `W`, then `L ≤ e^{-bκn} Z_n(b, g) ≤ U` at `b = 49/4`. -/
theorem shiftedTrace_mem {n : ℕ} (h4 : 4 ≤ n) (h12 : n ≤ 12) (g : Fin 2) {W : ℕ}
    (hW : hornerTotal n g = W) :
    (thermalLower n W : ℝ) ≤ shiftedTrace (49 / 4) kappa n (gibbsTrace (hamZ n g) (49 / 4)) ∧
      shiftedTrace (49 / 4) kappa n (gibbsTrace (hamZ n g) (49 / 4)) ≤ thermalUpper n W := by
  -- Shift the Hamiltonian by `κn`, so that `e^{bc} = e^{x_n}` with `c = 3n/2 - κn`.
  set a : ℝ := (kappa : ℝ) * n with ha
  set c : ℝ := 3 * n / 2 - a with hc
  have hH' : (hamZ n g + (a : ℂ) • 1).IsHermitian :=
    (hamZ_isHermitian n g).add (isHermitian_one.smul (Complex.conj_ofReal a))
  have hshift : shiftedTrace (49 / 4) kappa n (gibbsTrace (hamZ n g) (49 / 4)) =
      gibbsTrace (hamZ n g + (a : ℂ) • 1) (49 / 4) := by
    rw [gibbsTrace_add_smul_one, shiftedTrace, ha, mul_assoc]
  have hhalf : gibbsHalf (hamZ n g + (a : ℂ) • 1) (49 / 4) c =
      gibbsHalf (hamZ n g) (49 / 4) (3 * n / 2) := by
    rw [gibbsHalf_add_smul_one, hc, add_sub_cancel]
  have hx : (49 / 4 : ℝ) * c = (thermalX n : ℝ) := by
    rw [hc, ha, thermalX]; push_cast; ring
  obtain ⟨hx0, hx15⟩ := thermalX_mem h12
  obtain ⟨hs, ht⟩ := exp_mem_Icc_taylor_100 hx0 hx15
  have hS : (taylorS n : ℝ) = ∑ j ∈ range 101, (thermalX n : ℝ) ^ j / j ! := by
    push_cast [taylorS]; rfl
  have hT : (taylorT n : ℝ) = (thermalX n : ℝ) ^ 100 / (100 ! : ℝ) := by
    push_cast [taylorT]; rfl
  have hQ : (0 : ℝ) < (thermalScale : ℝ) := by rw [thermalScale]; positivity
  have h := gibbsTrace_enclosure_of_rep hH' (49 / 4) c thermalRep
    (fun r ↦ by
      rw [hhalf]
      exact nsq_gibbsHalf_rep (wordGens n) (isColumnSymmetry_wordGens (by omega) g) thermalRep
        exists_closure_thermalRep _ _ r)
    (fun ρ w ↦ (thermalColumn n g ρ w : ℂ)) (Q := (thermalScale : ℝ)) (E := columnError n)
    (ℰ := frobeniusError n) hQ (Nat.cast_nonneg _)
    (fun ρ _ ↦ by rw [hhalf]; exact thermalColumn_error (by omega) h12 g ρ)
    (Nat.cast_nonneg _) ?_ (W := W) (r := Nat.sqrt W) ?_ (by exact_mod_cast Nat.sqrt_le' W)
    (by exact_mod_cast Nat.lt_succ_sqrt' W) (s := (taylorS n : ℝ)) (t := (taylorT n : ℝ))
    (by rw [hx, hS]; exact hs) (by rw [hx, hS, hT]; exact ht)
  · rw [hshift]
    have hL : (thermalLower n W : ℝ) = (taylorS n : ℝ) *
        max 0 ((Nat.sqrt W : ℝ) - (frobeniusError n : ℝ)) ^ 2 / (thermalScale : ℝ) ^ 2 := by
      push_cast [thermalLower]; rfl
    have hU : (thermalUpper n W : ℝ) = ((taylorS n : ℝ) + (taylorT n : ℝ)) *
        ((Nat.sqrt W : ℝ) + 1 + (frobeniusError n : ℝ)) ^ 2 / (thermalScale : ℝ) ^ 2 := by
      push_cast [thermalUpper]; rfl
    rw [hL, hU]
    exact h
  · -- `3ⁿ E² ≤ (d E)²` because `3ⁿ < d²`.
    rw [card_words, frobeniusError, Nat.cast_mul, mul_pow]
    have h3 : ((3 ^ n : ℕ) : ℝ) ≤ (thermalDim n : ℝ) ^ 2 := by
      exact_mod_cast (three_pow_lt_thermalDim_sq n).le
    exact mul_le_mul_of_nonneg_right h3 (sq_nonneg _)
  · -- The real total is the integer total.
    simp_rw [Spectral.nsq_intCast]
    have := congrArg (Int.cast : ℤ → ℝ) hW
    rw [hornerTotal] at this
    push_cast at this ⊢
    exact this

/-- The table centers of the two rings: `g = 0` untwisted, `g = 1` twisted. -/
def thermalCenter (n : ℕ) : Fin 2 → ℚ := ![traceCenter n, twistedCenter n]

/-- **The final rational check** (§"Exact totals and rational enclosures"): for the printed
totals, both endpoints lie within `3 × 10⁻⁵` of the table centers, at all eighteen points.
Checked in the kernel. -/
theorem thermalChecks : ∀ n ∈ tableLengths, ∀ g : Fin 2,
    thermalCenter n g - 3 / 100000 ≤ thermalLower n (paperTotal n g) ∧
      thermalUpper n (paperTotal n g) ≤ thermalCenter n g + 3 / 100000 := by
  decide +kernel

/-- The paper's sharper form: the strict inequalities `L > (C - 30)/10⁶`, `U < (C + 30)/10⁶`
hold with margin greater than `13/10⁶`. -/
theorem thermalMargins : ∀ n ∈ tableLengths, ∀ g : Fin 2,
    thermalCenter n g - 30 / 10 ^ 6 + 13 / 10 ^ 6 < thermalLower n (paperTotal n g) ∧
      thermalUpper n (paperTotal n g) < thermalCenter n g + 30 / 10 ^ 6 - 13 / 10 ^ 6 := by
  decide +kernel

/-- **The trace table from the integer totals.** If the integer algorithm of `thermal72.tex`
reproduces the printed totals `W_{n,g}`, the shifted traces `e^{-bκn} Z_n(b, g)` at `b = 49/4`
lie within `3 × 10⁻⁵` of the table centers. -/
theorem traceTable_of_hornerTotals (h : HornerTotals) : TraceTable := by
  intro n hn
  have hn' : 4 ≤ n ∧ n ≤ 12 := by
    simp only [tableLengths, List.mem_cons, List.not_mem_nil, or_false] at hn
    omega
  have hne : n ≠ 1 := by omega
  have key : ∀ g : Fin 2, |shiftedTrace (49 / 4) kappa n (gibbsTrace (hamZ n g) (49 / 4)) -
      (thermalCenter n g : ℝ)| ≤ 3 / 100000 := by
    intro g
    obtain ⟨hl, hu⟩ := shiftedTrace_mem hn'.1 hn'.2 g (h n hn g)
    obtain ⟨cl, cu⟩ := thermalChecks n hn g
    have cl' := (Rat.cast_le (K := ℝ)).2 cl
    have cu' := (Rat.cast_le (K := ℝ)).2 cu
    push_cast at cl' cu'
    rw [abs_sub_le_iff]
    constructor <;> linarith
  constructor
  · have := key 0
    rwa [gibbsTrace_hamZ_zero hne] at this
  · have := key 1
    rwa [gibbsTrace_hamZ_one hne] at this

/-- **The gap for every even `L ≥ 36` from the integer totals and a trial state.** -/
theorem gap_thirtysix_of_hornerTotals_mps (h : HornerTotals) {D : Type*} [Fintype D]
    [DecidableEq D] (A : Fin 3 → Matrix D D ℤ)
    (hU : 500000 * trace (mpsTransfer A ^ 70 * mpsInsertion A) <
      -700741 * trace (mpsTransfer A ^ 72))
    {L : ℕ} (hL : 36 ≤ L) (hLe : Even L) :
    GapGT (spectrum L) (Real.log (105882 / 100000) / (49 / 4)) :=
  gap_thirtysix_of_table_mps (traceTable_of_hornerTotals h) A hU hL hLe

end CertifiedGaps.SpinOneHeisenberg
