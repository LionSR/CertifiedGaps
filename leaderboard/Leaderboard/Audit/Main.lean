import Lean
import Leaderboard.Attr

/-!
# `lake exe leaderboard_audit <out.json>`

Loads the compiled `Leaderboard` library and, for every `@[gap_record]` theorem:

* checks that its statement is `Leaderboard.Record.Unconditional spectrum L₀ r β` or
  `Leaderboard.Record.Conditional H spectrum L₀ r β` (after unfolding reducible definitions only);
* reads `L₀`, `r` and `β` by **kernel** reduction to literals (never by compiled code, which an
  `implemented_by` could make disagree with the statement);
* collects its axioms and rejects any outside `propext`, `Classical.choice`, `Quot.sound`, in
  particular `sorryAx` (`sorry`) and the axioms of `native_decide` (`Lean.ofReduceBool`, or the
  auxiliary `*._native.native_decide.ax_*` axioms of recent toolchains).

It also rejects an untagged theorem of a `Leaderboard` module whose statement is a record (so
that a forgotten tag cannot drop a record silently) and pretty-printer extensions in `Leaderboard`
modules (`notation`, unexpanders, delaborators), since reviewers read the printed statements.
On success it writes a JSON array sorted by name (to stdout if the argument is `-` or missing);
on failure it writes nothing and exits 1.

The executable links only `Leaderboard.Attr` (Lean core) and imports the library at run time from
its `.olean` files, so it never compiles Mathlib to C. The olean data is trusted here;
`lake exe leaderboard_recheck` replays it through the kernel.
-/

open Lean Meta

namespace Leaderboard.Audit

/-- The axioms a record may use: the three standard axioms of Lean and Mathlib. -/
def allowedAxioms : List Name := [``propext, ``Classical.choice, ``Quot.sound]

/-- The types of pretty-printer hooks: unexpanders (generated by `notation`) and delaborators. -/
def ppHooks : List Name :=
  [``Lean.PrettyPrinter.Unexpander, ``Lean.PrettyPrinter.Delaborator.Delab]

/-- Weak head normal form by the kernel, which ignores `implemented_by` and transparency. -/
def kernelWhnf (e : Expr) : MetaM Expr := do
  match Kernel.whnf (← getEnv) {} e with
  | .ok e => return e
  | .error ex => throwError "kernel reduction failed: {ex.toMessageData {}}"

/-- A closed natural-number term, reduced by the kernel to a literal. -/
partial def evalNat (e : Expr) : MetaM Nat := do
  let e ← kernelWhnf e
  match e with
  | .lit (.natVal n) => return n
  | .const ``Nat.zero _ => return 0
  | .app (.const ``Nat.succ _) a => return (← evalNat a) + 1
  | _ => throwError "not a natural-number literal after kernel reduction: {e}"

/-- A closed integer term, reduced by the kernel to `Int.ofNat n` or `Int.negSucc n`. -/
def evalInt (e : Expr) : MetaM Int := do
  let e ← kernelWhnf e
  match e.getAppFn.constName?, e.getAppArgs with
  | some ``Int.ofNat, #[n] => return (← evalNat n)
  | some ``Int.negSucc, #[n] => return -((← evalNat n : Int) + 1)
  | _, _ => throwError "not an integer literal after kernel reduction: {e}"

/-- A closed rational term, reduced by the kernel to the structure `Rat.mk' num den _ _`, as the
string `"num"` or `"num/den"`. The structure invariant makes `num/den` the reduced form. -/
def evalRat (e : Expr) : MetaM (String × Int × Nat) := do
  let e ← kernelWhnf e
  match e.getAppFn.constName?, e.getAppArgs with
  | some ``Rat.mk', #[num, den, _, _] =>
    let num ← evalInt num
    let den ← evalNat den
    return (if den == 1 then s!"{num}" else s!"{num}/{den}", num, den)
  | _, _ => throwError "not a rational literal after kernel reduction: {e}"

/-- Pretty-printing for review: full names, binder types and one line, so that the printed
spectrum and hypothesis name every constant unambiguously. -/
def ppOptions (o : Options) : Options :=
  o |>.set `pp.fullNames true |>.set `pp.funBinderTypes true
    |>.set `format.width (1000000 : Nat)

/-- Pretty-prints `e` on one line. -/
def pp (e : Expr) : MetaM String := do
  return (← withOptions ppOptions (ppExpr e)).pretty 1000000

/-- The fields of one record. -/
structure Entry where
  /-- The theorem name. -/
  name : Name
  /-- The JSON object of the record. -/
  json : Json

/-- Audits the record theorem `n` of module `mod`: its JSON entry, or the list of problems. -/
def auditRecord (n : Name) (mod : Name) : MetaM (Except (List String) Entry) := do
  let info ← getConstInfo n
  let mut errs : List String := []
  unless info.isTheorem do
    errs := errs ++ [s!"{n}: not a theorem"]
  let axioms ← collectAxioms n
  let bad := axioms.filter (!allowedAxioms.contains ·)
  unless bad.isEmpty do
    errs := errs ++ [s!"{n}: disallowed axioms {bad.toList} (`sorry` adds sorryAx, \
      `native_decide` adds Lean.ofReduceBool or `*._native.native_decide.ax_*` axioms; only \
      {allowedAxioms} are allowed)"]
  let type ← whnfR (← instantiateMVars info.type)
  let args := type.getAppArgs
  let fields? : Option (String × Option Expr × Expr × Expr × Expr × Expr) :=
    match type.getAppFn.constName?, args.size with
    | some `Leaderboard.Record.Unconditional, 5 =>
      some ("unconditional", none, args[1]!, args[2]!, args[3]!, args[4]!)
    | some `Leaderboard.Record.Conditional, 6 =>
      some ("conditional", some args[0]!, args[2]!, args[3]!, args[4]!, args[5]!)
    | _, _ => none
  let some (kind, hyp, spectrum, L₀, r, β) := fields? |
    return .error (errs ++ [s!"{n}: the statement is not a fully applied \
      Leaderboard.Record.Unconditional or Leaderboard.Record.Conditional"])
  let ok ← try
      let L₀ ← evalNat L₀
      let (rs, rnum, rden) ← evalRat r
      let (βs, βnum, _) ← evalRat β
      -- Already part of the proved statement; repeated so that a bad record fails loudly.
      if rnum ≤ rden then throwError "r = {rs} is not > 1"
      if βnum ≤ 0 then throwError "β = {βs} is not > 0"
      pure (some (L₀, rs, βs))
    catch e =>
      errs := errs ++ [s!"{n}: {← e.toMessageData.toString}"]
      pure none
  let some (L₀, rs, βs) := ok | return .error errs
  unless errs.isEmpty do return .error errs
  let hypJson ← match hyp with
    | some h => pure (Json.str (← pp h))
    | none => pure Json.null
  return .ok {
    name := n
    json := Json.mkObj [
      ("name", toJson n.toString),
      ("kind", toJson kind),
      ("spectrum", toJson (← pp spectrum)),
      ("L0", toJson L₀),
      ("r", toJson rs),
      ("beta", toJson βs),
      ("hypothesis", hypJson),
      ("axioms", toJson (axioms.map (·.toString) |>.qsort (· < ·))),
      ("module", toJson mod.toString)] }

/-- Runs the audit on the loaded environment: the JSON array, or every problem found. -/
def run : MetaM (Except (List String) Json) := do
  let env ← getEnv
  let mut entries : Array Entry := #[]
  let mut errs : List String := []
  for h : idx in [0:env.header.moduleNames.size] do
    let mod := env.header.moduleNames[idx]
    for n in gapRecordAttr.ext.getModuleEntries env idx do
      match ← auditRecord n mod with
      | .ok e => entries := entries.push e
      | .error es => errs := errs ++ es
    if (`Leaderboard).isPrefixOf mod then
      for n in env.header.moduleData[idx]!.constNames do
        let some info := env.find? n | continue
        -- A theorem of a leaderboard module that states a record must carry the tag.
        if info.isTheorem && !gapRecordAttr.hasTag env n &&
            (← recordHead? info.type).isSome then
          errs := errs ++ [s!"{n} ({mod}): states a record but lacks @[gap_record]"]
        -- The printed statements are what reviewers read, so a leaderboard module must not
        -- change how terms print (`notation` and `@[app_unexpander]` define unexpanders).
        if ppHooks.contains (info.type.getAppFn.constName?.getD .anonymous) then
          errs := errs ++ [s!"{n} ({mod}): pretty-printer extensions (notation, unexpanders, \
            delaborators) are not allowed in Leaderboard modules"]
  if entries.isEmpty && errs.isEmpty then
    errs := ["no @[gap_record] theorems found"]
  unless errs.isEmpty do return .error errs
  let sorted := entries.qsort (·.name.toString < ·.name.toString)
  return .ok (Json.arr (sorted.map (·.json)))

end Leaderboard.Audit

open Leaderboard.Audit in
/-- `leaderboard_audit [out.json]`. -/
unsafe def main (args : List String) : IO UInt32 := do
  let out := args.headD "-"
  initSearchPath (← findSysroot)
  enableInitializersExecution
  let env ← importModules #[{ module := `Leaderboard }] {} (trustLevel := 1024)
    (loadExts := true)
  let ctx : Core.Context := {
    fileName := "<leaderboard_audit>"
    fileMap := default
    maxHeartbeats := 0
    maxRecDepth := 100000 }
  let result ← (run.run' {} {}).toIO' ctx { env }
  match result with
  | .error errs =>
    IO.eprintln "leaderboard_audit: FAILED"
    for e in errs do IO.eprintln s!"  {e}"
    return 1
  | .ok json =>
    let text := json.pretty ++ "\n"
    if out == "-" then
      IO.print text
    else
      if let some dir := (System.FilePath.mk out).parent then
        if dir.toString != "" then IO.FS.createDirAll dir
      IO.FS.writeFile out text
      let count := match json with | .arr a => a.size | _ => 0
      IO.eprintln s!"leaderboard_audit: {count} records written to {out}"
    return 0
