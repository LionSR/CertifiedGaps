# Local reading notes, archived drafts, and build products
/work/
.DS_Store

# LaTeX intermediate files (the final PDF is tracked)
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
*Notes.bib

# Survey of the criterion across models (kept local only)
/survey/

# Not part of the repository: downloaded papers and upstream evidence (fetch the evidence
# spin1 needs with `julia code/tools/fetch_upstream.jl`)
/data/references/*
!/data/references/README.md

# No Python in this repository (local analysis helpers stay local)
*.py

# Editor and build caches
paper/.texpadtmp/
code/lean/.lake
*.tmp
*.jls

# Model-specific ignores (regenerable results) live in data/.gitignore and code/models/<slug>/.gitignore.
/.lake/

# Blueprint build products
/blueprint/web/
/blueprint/print/
/blueprint/lean_decls
/blueprint/src/web.bbl
/blueprint/src/web.paux
/docbuild/

# Home page build products: docgen-action writes the blueprint and API docs into home_page/,
# blueprint.yml copies the explainer and the note PDFs there and generates the Lean records
# (`lake exe leaderboard_audit`), and Jekyll writes _site/.
.sass-cache/
/home_page/_site/
/home_page/.jekyll-cache/
/home_page/.sass-cache/
/home_page/vendor/
/home_page/blueprint/
/home_page/blueprint.pdf
/home_page/docs/
/home_page/explainer/
/home_page/notes/
/home_page/_data/lean_records.json
