# Local reading notes, archived drafts, and build products
/work/
.DS_Store

# LaTeX intermediate files (the final PDF is tracked)
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
*Notes.bib

# Survey of the criterion across models (kept local only)
/survey/

# Not part of the repository: downloaded papers and upstream evidence (fetch the evidence
# spin1 needs with `julia tools/fetch_upstream.jl`), scratch reproductions
/references/
/working/

# No Python in this repository (aklt's local analysis helpers stay local)
*.py

# Editor and build caches
outputs/.texpadtmp/
lean/.lake/
*.tmp
*.jls

# Large or regenerable result data; small certificates read by tests are tracked
/models/aklt/results/
/models/spin2/results/*
!/models/spin2/results/trial-certificate.json
!/models/spin2/results/trial-137-certificate.json
!/models/spin2/results/trial-295-symmetric-certificate.json
