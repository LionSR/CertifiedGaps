import CertifiedGaps.Ring.Gap
import CertifiedGaps.Local.SpinOne

/-!
# The spin-one chain with single-ion anisotropy

`H_L = ∑ⱼ Sⱼ · Sⱼ₊₁ + D ∑ⱼ (Sᶻⱼ)²` on a periodic ring, in the Cartesian basis
`(S^α)_{s s'} = -i ε_{α s s'}` of `SpinOneHeisenberg.spinOne`. It is a reflection-positive ring
(`model D`) with real antisymmetric bond factors `C_α = SpinOne.G α = i S^α`, since
`-S · S = ∑_α G_α ⊗ G_α`, and the real on-site term `D (Sᶻ)² = D diag(1, 1, 0)`
(`hamiltonian_eq`). At `D = 0` it is the Heisenberg ring (`partitionFunction_zero`).

## Main results

* `gap`: at every point `p ∈ points` (`D = 4` and `D = 1603/500`), every even ring of `L ≥ 6`
  sites has a unique ground state and gap `Δ_L > log r / β₀` (`≈ 0.693` and `≈ 0.00214`).

It depends on the seed inequalities `seeds` (`sorry`), which are certified numerically in
`models/spin1_largeD` (complete spectra of the rings of `6` and `12` sites with rigorous
eigenvalue enclosures). Everything else is proved, and the rational chain certificates are
checked by `decide`.
-/

open Matrix Real
open scoped Kronecker

namespace CertifiedGaps.SpinOneLargeD

open SpinOne

/-- `(Sᶻ)² = diag(1, 1, 0)` in the Cartesian basis. -/
def Sz2 : Matrix (Fin 3) (Fin 3) ℝ := !![1, 0, 0; 0, 1, 0; 0, 0, 0]

/-- The spin-one chain with anisotropy `D` as a reflection-positive ring. -/
noncomputable def model (D : ℝ) : RPRing (Fin 3) (Fin 3) where
  C := G
  o := D • Sz2
  C_symm α := .inr (G_transpose α)
  o_symm := by ext i j; fin_cases i <;> fin_cases j <;> simp [Sz2]

/-- The bond of the ring is the exchange `S · S`. -/
theorem bondMatrix_eq (D : ℝ) : (model D).bondMatrix = SpinOneHeisenberg.exchange := by
  rw [RPRing.bondMatrix]
  simp_rw [(model D).Dc_eq_of_refl rfl]
  rw [← Finset.sum_neg_distrib]
  ext ⟨a, b⟩ ⟨c, e⟩
  simp only [RPRing.Cc, model, G, SpinOneHeisenberg.exchange, SpinOneHeisenberg.spinOne,
    Matrix.neg_apply, Matrix.sum_apply, kroneckerMap_apply, map_apply, of_apply]
  refine Finset.sum_congr rfl fun α _ ↦ ?_
  push_cast
  linear_combination -(SpinOneHeisenberg.leviCivita α a c : ℂ) *
    SpinOneHeisenberg.leviCivita α b e * Complex.I_sq

/-- The on-site term of the ring is `D (Sᶻ)²`. -/
theorem oc_eq (D : ℝ) :
    (model D).oc = (D : ℂ) • (SpinOneHeisenberg.spinOne 2 * SpinOneHeisenberg.spinOne 2) := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [RPRing.oc, model, Sz2, SpinOneHeisenberg.spinOne, SpinOneHeisenberg.leviCivita,
      mul_apply, Fin.sum_univ_three]

/-- The Hamiltonian of the ring is `∑ⱼ Sⱼ · Sⱼ₊₁ + D ∑ⱼ (Sᶻⱼ)²`. -/
theorem hamiltonian_eq (D : ℝ) (L : ℕ) :
    (model D).hamiltonian L = SpinOneHeisenberg.hamiltonian L +
      ∑ j : Fin L, siteOp j ((D : ℂ) • (SpinOneHeisenberg.spinOne 2 * SpinOneHeisenberg.spinOne 2))
    := by
  simp only [RPRing.hamiltonian, RPRing.bond, RPRing.site, bondMatrix_eq, oc_eq]
  rfl

/-- At `D = 0` the ring is the Heisenberg ring: the partition functions agree. -/
theorem partitionFunction_zero (L : ℕ) (β : ℝ) :
    (model 0).partitionFunction L β = SpinOneHeisenberg.partitionFunction L β := by
  have h0 : ∀ j : Fin L, siteOp j ((((0 : ℝ) : ℂ)) •
      (SpinOneHeisenberg.spinOne 2 * SpinOneHeisenberg.spinOne 2)) = 0 := fun j ↦ by
    simpa using siteOp_zero j
  rw [RPRing.partitionFunction, SpinOneHeisenberg.partitionFunction, hamiltonian_eq,
    Finset.sum_congr rfl fun j _ ↦ h0 j, Finset.sum_const_zero, add_zero]

/-- A certified point: the anisotropy, the seed inverse temperature `β₀` (the seed length is
`n₀ = 6` sites) and the chain certificate, whose first entries are the seed defects. -/
structure Point where
  /-- The single-ion anisotropy. -/
  D : ℚ
  /-- The seed inverse temperature. -/
  β₀ : ℚ
  /-- The chain certificate. -/
  cert : ChainCertificate

/-- The two points of `models/spin1_largeD`, generated by `lean/scripts/chain_certificate.jl`
from the certified seed defects. -/
def points : List Point := [
  -- D = 4: bound log 4.755 / (9/4) ≈ 0.6930;
  -- εₛ = 577405872923865/2^53 ≈ 0.0641053, εₜ = 45632040552745/2^50 ≈ 0.0405296
  ⟨4, 9 / 4, {
    s := [6411e-5, 1804e-5, 923e-6, 1852e-9, 6904e-15, 9534e-26, 1818e-47, 6611e-91, 8742e-178]
    t := [4053e-5, 5642e-6, 7583e-8, 1179e-11, 2782e-19, 1548e-34, 4793e-65, 4595e-126,
        4223e-248]
    r := 4755e-3
    ε := 8742e-178 }⟩,
  -- D = 1603/500: bound log 1.0065429 / (381/125) ≈ 0.00214;
  -- εₛ = 863088513139635/2^52, εₜ = 418496566764289/2^53
  ⟨1603 / 500, 381 / 125, {
    s := [19164415e-8, 18297225e-8, 17612535e-8, 17032432e-8, 16479135e-8, 15798379e-8,
        1458129e-7, 11855674e-8, 66174818e-9, 1457023e-8, 49620776e-11, 50048572e-14,
        50108752e-20]
    t := [46462453e-9, 59903624e-9, 69710309e-9, 77103683e-9, 82304842e-9, 84134627e-9,
        78278607e-9, 56241354e-9, 20462469e-9, 16603838e-10, 73235899e-13, 11472844e-17,
        26440334e-27]
    r := 10065429e-7
    ε := 50108752e-20 }⟩]

/-- Both certificates are valid, checked by the kernel. -/
theorem points_valid : ∀ p ∈ points, p.cert.Valid := by decide +kernel

/-- Every seed inverse temperature is positive. -/
theorem points_β₀_pos : ∀ p ∈ points, 0 < p.β₀ := by decide +kernel

/-- The seeds: for every point, `P_s(6, β₀) ≥ 1 - εₛ` and `P_τ(12, β₀) ≥ 1 - εₜ`.
Certified in `models/spin1_largeD`. -/
theorem seeds : ∀ p ∈ points,
    1 - (p.cert.sAt 0 : ℝ) ≤ (model p.D).spatialPurity 6 p.β₀ ∧
      1 - (p.cert.tAt 0 : ℝ) ≤ (model p.D).thermalPurity 12 p.β₀ := by
  sorry

/-- **The spin-one chain with single-ion anisotropy.** At every point, every even ring of
`L ≥ 6` sites has a unique ground state and gap `Δ_L > log r / β₀`. -/
theorem gap {p : Point} (hp : p ∈ points) {L : ℕ} (hL : 6 ≤ L) (hLe : Even L) :
    GapGT ((model p.D).spectrum L) (log (p.cert.r : ℝ) / p.β₀) :=
  (model p.D).gapGT_of_chainCertificate (n₀ := 6) (by norm_num) (by decide)
    (by exact_mod_cast points_β₀_pos p hp) (points_valid p hp) ⟨rfl, rfl, rfl⟩ (seeds p hp).1
    (seeds p hp).2 hL hLe

end CertifiedGaps.SpinOneLargeD
