import CertifiedGaps.Ring.Gap
import CertifiedGaps.Heisenberg.Hamiltonian

/-!
# The spin-one chain with single-ion anisotropy

`H_L = ∑ⱼ Sⱼ · Sⱼ₊₁ + D ∑ⱼ (Sᶻⱼ)²` on a periodic ring, in the Cartesian basis
`(S^α)_{s s'} = -i ε_{α s s'}` of `SpinOneHeisenberg.spinOne`. It is a reflection-positive ring
(`model D`) with real antisymmetric bond factors `C_α = ε_α = i S^α`, since
`-S · S = ∑_α ε_α ⊗ ε_α`, and the real on-site term `D (Sᶻ)² = D diag(1, 1, 0)`
(`hamiltonian_eq`).

## Main results

* `gap_D4`: at `D = 4`, every even ring of `L ≥ 6` sites has a unique ground state and gap
  `Δ_L > log (4.755) / (9/4) ≈ 0.693`.
* `gap_D3206`: at `D = 1603/500`, the same with `L ≥ 6` and `Δ_L > log (1.0065429) / (381/125)
  ≈ 0.00214`.

Each depends on two seed inequalities, `seed_spatial_*` and `seed_thermal_*` (`sorry`), which
are certified numerically in `models/spin1_largeD` (complete spectra of the rings of `6` and
`12` sites with rigorous eigenvalue enclosures). Everything else is proved, and the rational
chain certificates are checked by `decide`.
-/

open Matrix Real
open scoped Kronecker

namespace CertifiedGaps.SpinOneLargeD

/-- The real bond factors `ε_α = i S^α`, with entries `ε_{α s s'}`. -/
def G (α : Fin 3) : Matrix (Fin 3) (Fin 3) ℝ :=
  of fun s s' ↦ (SpinOneHeisenberg.leviCivita α s s' : ℝ)

/-- The factors `ε_α` are antisymmetric. -/
theorem G_transpose (α : Fin 3) : (G α)ᵀ = -G α := by
  ext s s'; simp [G, SpinOneHeisenberg.leviCivita_swap α s s']

/-- `(Sᶻ)² = diag(1, 1, 0)` in the Cartesian basis. -/
def Sz2 : Matrix (Fin 3) (Fin 3) ℝ := !![1, 0, 0; 0, 1, 0; 0, 0, 0]

/-- The spin-one chain with anisotropy `D` as a reflection-positive ring. -/
noncomputable def model (D : ℝ) : RPRing (Fin 3) (Fin 3) where
  C := G
  o := D • Sz2
  C_symm α := .inr (G_transpose α)
  o_symm := by ext i j; fin_cases i <;> fin_cases j <;> simp [Sz2]

/-- The bond of the ring is the exchange `S · S`. -/
theorem bondMatrix_eq (D : ℝ) : (model D).bondMatrix = SpinOneHeisenberg.exchange := by
  rw [RPRing.bondMatrix]
  simp_rw [(model D).Dc_eq_of_refl rfl]
  rw [← Finset.sum_neg_distrib]
  ext ⟨a, b⟩ ⟨c, e⟩
  simp only [RPRing.Cc, model, G, SpinOneHeisenberg.exchange, SpinOneHeisenberg.spinOne,
    Matrix.neg_apply, Matrix.sum_apply, kroneckerMap_apply, map_apply, of_apply]
  refine Finset.sum_congr rfl fun α _ ↦ ?_
  push_cast
  linear_combination -(SpinOneHeisenberg.leviCivita α a c : ℂ) *
    SpinOneHeisenberg.leviCivita α b e * Complex.I_sq

/-- The on-site term of the ring is `D (Sᶻ)²`. -/
theorem oc_eq (D : ℝ) :
    (model D).oc = (D : ℂ) • (SpinOneHeisenberg.spinOne 2 * SpinOneHeisenberg.spinOne 2) := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [RPRing.oc, model, Sz2, SpinOneHeisenberg.spinOne, SpinOneHeisenberg.leviCivita,
      mul_apply, Fin.sum_univ_three]

/-- The Hamiltonian of the ring is `∑ⱼ Sⱼ · Sⱼ₊₁ + D ∑ⱼ (Sᶻⱼ)²`. -/
theorem hamiltonian_eq (D : ℝ) (L : ℕ) :
    (model D).hamiltonian L = SpinOneHeisenberg.hamiltonian L +
      ∑ j : Fin L, siteOp j ((D : ℂ) • (SpinOneHeisenberg.spinOne 2 * SpinOneHeisenberg.spinOne 2))
    := by
  simp only [RPRing.hamiltonian, RPRing.bond, RPRing.site, bondMatrix_eq, oc_eq]
  rfl

/-- At `D = 0` the ring is the Heisenberg ring: the partition functions agree. -/
theorem partitionFunction_zero (L : ℕ) (β : ℝ) :
    (model 0).partitionFunction L β = SpinOneHeisenberg.partitionFunction L β := by
  have h0 : ∀ j : Fin L, siteOp j ((((0 : ℝ) : ℂ)) •
      (SpinOneHeisenberg.spinOne 2 * SpinOneHeisenberg.spinOne 2)) = 0 := fun j ↦ by
    ext σ τ
    rw [siteOp, piTensor_apply]
    exact Finset.prod_eq_zero (Finset.mem_univ j) (by simp)
  rw [RPRing.partitionFunction, SpinOneHeisenberg.partitionFunction, hamiltonian_eq,
    Finset.sum_congr rfl fun j _ ↦ h0 j, Finset.sum_const_zero, add_zero]

/-! ### `D = 4` -/

/-- The rational chain certificate for `D = 4`, seed `(n₀, β₀) = (6, 9/4)`. Generated by
`lean/scripts/chain_certificate.jl` from the certified seed defects. -/
def certD4 : ChainCertificate where
  s := [6411e-5, 1804e-5, 923e-6, 1852e-9, 6904e-15, 9534e-26, 1818e-47, 6611e-91, 8742e-178]
  t := [4053e-5, 5642e-6, 7583e-8, 1179e-11, 2782e-19, 1548e-34, 4793e-65, 4595e-126, 4223e-248]
  r := 4755e-3
  ε := 8742e-178

/-- The certificate is valid, checked by the kernel. -/
theorem certD4_valid : certD4.Valid := by decide +kernel

/-- Seed: `P_s(6, 9/4) ≥ 1 - 0.06411`. Certified in `models/spin1_largeD`
(`εₛ = 577405872923865/2^53 ≈ 0.0641053`). -/
theorem seed_spatial_D4 : 1 - (6411e-5 : ℝ) ≤ (model 4).spatialPurity 6 (9 / 4) := by
  sorry

/-- Seed: `P_τ(12, 9/4) ≥ 1 - 0.04053`. Certified in `models/spin1_largeD`
(`εₜ = 45632040552745/2^50 ≈ 0.0405296`). -/
theorem seed_thermal_D4 : 1 - (4053e-5 : ℝ) ≤ (model 4).thermalPurity 12 (9 / 4) := by
  sorry

/-- **The spin-one chain at `D = 4`.** Every even ring of `L ≥ 6` sites has a unique ground
state and gap `Δ_L > log (4.755) / (9/4) ≈ 0.6930`. -/
theorem gap_D4 {L : ℕ} (hL : 6 ≤ L) (hLe : Even L) :
    GapGT ((model 4).spectrum L) (log 4.755 / (9 / 4)) :=
  (model 4).gapGT_of_chainCertificate (by norm_num) (by decide) (by norm_num)
    certD4_valid (by norm_num [certD4, ChainCertificate.sAt, ChainCertificate.tAt])
    seed_spatial_D4 seed_thermal_D4 hL hLe

