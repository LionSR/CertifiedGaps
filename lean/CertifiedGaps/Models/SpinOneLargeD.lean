theorem gap_D3206 {L : ℕ} (hL : 6 ≤ L) (hLe : Even L) :
    GapGT ((model (1603 / 500)).spectrum L) (log 1.0065429 / (381 / 125)) :=
  (model (1603 / 500)).gapGT_of_chainCertificate (by norm_num) (by decide) (by norm_num)
