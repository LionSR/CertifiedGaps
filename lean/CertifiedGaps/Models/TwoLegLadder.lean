import CertifiedGaps.Ring.Gap
import CertifiedGaps.Models.SpinHalf

/-!
# The spin-one-half two-leg Heisenberg ladder

The ladder `H = ∑_{legs} Sᵢ · Sⱼ + J_⊥ ∑_{rungs} Sᵢ · Sⱼ` (`J_∥ = 1`) on a periodic ring of `L`
rungs. The sublattice rotation `U = ∏_{i ∈ B} e^{iπSʸᵢ}` on the checkerboard
`B = {(1, j) : j odd} ∪ {(2, j) : j even}` turns every bond into `-SˣSˣ + SʸSʸ - SᶻSᶻ`; for an
even number of rungs `U` is a unitary on the ring, so the rotated ladder has the same spectrum.
This file states the result for the rotated ladder `model J⊥`, a ring of rungs with cell space
`Fin 2 × Fin 2` (leg `a` ⊗ leg `b`) and

* bond factors `Sˣ ⊗ 1, iSʸ ⊗ 1, Sᶻ ⊗ 1, 1 ⊗ Sˣ, 1 ⊗ iSʸ, 1 ⊗ Sᶻ` (real, since `iSʸ` is real),
  so `-h = ∑_{legs} (Sˣ ⊗ Sˣ + iSʸ ⊗ iSʸ + Sᶻ ⊗ Sᶻ) = ∑_{legs} (SˣSˣ - SʸSʸ + SᶻSᶻ)`;
* the rung as on-site term `o = -J_⊥ (Sˣ ⊗ Sˣ + iSʸ ⊗ iSʸ + Sᶻ ⊗ Sᶻ)`.

## Main results

* `gap_J4`: at `J_⊥ = 4`, every even ring of `L ≥ 4` rungs has a unique ground state and gap
  `Δ_L > log (9.033) / 2 ≈ 1.1004`.

It depends on two seed inequalities (`sorry`), certified numerically in
`models/heisenberg_ladder` (complete spectra of the rings of `4` and `8` rungs).
-/

open Matrix Real
open scoped Kronecker

namespace CertifiedGaps.TwoLegLadder

open SpinHalf

/-- The rotated exchange `Sˣ ⊗ Sˣ + iSʸ ⊗ iSʸ + Sᶻ ⊗ Sᶻ = SˣSˣ - SʸSʸ + SᶻSᶻ` on the two legs of
a rung. -/
noncomputable def rungExchange : Matrix (Fin 2 × Fin 2) (Fin 2 × Fin 2) ℝ := ∑ k, P k ⊗ₖ P k

/-- The rotated two-leg ladder with rung coupling `J⊥`, as a reflection-positive ring of rungs. -/
noncomputable def model (Jperp : ℝ) : RPRing (Fin 2 × Fin 2) (Fin 2 × Fin 3) where
  C := fun α ↦ if α.1 = 0 then P α.2 ⊗ₖ 1 else 1 ⊗ₖ P α.2
  o := -Jperp • rungExchange
  C_symm α := by
    split_ifs
    · exact transpose_kronecker_eq_or (P_symm _) (.inl transpose_one)
    · exact transpose_kronecker_eq_or (.inl transpose_one) (P_symm _)
  o_symm := by rw [transpose_smul, rungExchange, transpose_sum_kronecker_self P P_symm]

/-- The rational chain certificate for `J⊥ = 4`, seed `(n₀, β₀) = (4, 2)`. Generated by
`lean/scripts/chain_certificate.jl` from the certified seed defects. -/
def certJ4 : ChainCertificate where
  s := [3509e-5, 5119e-6, 7123e-8, 1093e-11, 2402e-19, 1154e-34, 2664e-65, 142e-125, 4033e-249]
  t := [2463e-5, 1599e-6, 537e-8, 578e-13, 6682e-24, 893e-43, 1595e-83, 5089e-163, 518e-321]
  r := 9033e-3
  ε := 4033e-249

/-- The certificate is valid, checked by the kernel. -/
theorem certJ4_valid : certJ4.Valid := by decide +kernel

/-- Seed: `P_s(4, 2) ≥ 1 - 0.03509`. Certified in `models/heisenberg_ladder`
(`εₛ = 3508321/10⁸`). -/
theorem seed_spatial_J4 : 1 - (3509e-5 : ℝ) ≤ (model 4).spatialPurity 4 2 := by
  sorry

/-- Seed: `P_τ(8, 2) ≥ 1 - 0.02463`. Certified in `models/heisenberg_ladder`
(`εₜ = 123121/(5 · 10⁶)`). -/
theorem seed_thermal_J4 : 1 - (2463e-5 : ℝ) ≤ (model 4).thermalPurity 8 2 := by
  sorry

/-- **The rotated two-leg ladder at `J⊥ = 4`.** Every even ring of `L ≥ 4` rungs has a unique
ground state and gap `Δ_L > log (9.033) / 2 ≈ 1.1004`. -/
theorem gap_J4 {L : ℕ} (hL : 4 ≤ L) (hLe : Even L) :
    GapGT ((model 4).spectrum L) (log 9.033 / 2) :=
  (model 4).gapGT_of_chainCertificate (by norm_num) (by decide) (by norm_num)
    certJ4_valid (by norm_num [certJ4, ChainCertificate.sAt, ChainCertificate.tAt])
    seed_spatial_J4 seed_thermal_J4 hL hLe

end CertifiedGaps.TwoLegLadder
