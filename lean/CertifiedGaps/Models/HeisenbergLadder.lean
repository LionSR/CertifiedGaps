import CertifiedGaps.Ring.Gap
import CertifiedGaps.Local.SpinHalf

/-!
# The spin-one-half two-leg Heisenberg ladder

The ladder `H = ∑_{legs} Sᵢ · Sⱼ + J_⊥ ∑_{rungs} Sᵢ · Sⱼ` (`J_∥ = 1`) on a periodic ring of `L`
rungs. The sublattice rotation `U = ∏_{i ∈ B} e^{iπSʸᵢ}` on the checkerboard
`B = {(1, j) : j odd} ∪ {(2, j) : j even}` turns every bond into `-SˣSˣ + SʸSʸ - SᶻSᶻ`; for an
even number of rungs `U` is a unitary on the ring, so the rotated ladder has the same spectrum.
This file states the result for the rotated ladder `model J⊥`, a ring of rungs with cell space
`Fin 2 × Fin 2` (leg `a` ⊗ leg `b`) and

* bond factors `Sˣ ⊗ 1, iSʸ ⊗ 1, Sᶻ ⊗ 1, 1 ⊗ Sˣ, 1 ⊗ iSʸ, 1 ⊗ Sᶻ` (real, since `iSʸ` is real),
  so `-h = ∑_{legs} (Sˣ ⊗ Sˣ + iSʸ ⊗ iSʸ + Sᶻ ⊗ Sᶻ) = ∑_{legs} (SˣSˣ - SʸSʸ + SᶻSᶻ)`;
* the rung as on-site term `o = -J_⊥ (Sˣ ⊗ Sˣ + iSʸ ⊗ iSʸ + Sᶻ ⊗ Sᶻ)`.

The physical ladder is in `HeisenbergLadderPhysical`.

## Main results

* `gap`: at every point `p ∈ points` (`J_⊥ = 4`), every even ring of `L ≥ 4` rungs has a unique
  ground state and gap `Δ_L > log r / β₀` (`log 9.033 / 2 ≈ 1.1004` at `J_⊥ = 4`).

It depends on the seed inequalities `seeds` (`sorry`), certified numerically in
`models/heisenberg_ladder` (complete spectra of the rings of `4` and `8` rungs).
-/

open Matrix Real
open scoped Kronecker

namespace CertifiedGaps.HeisenbergLadder

open SpinHalf

/-- The rotated exchange `Sˣ ⊗ Sˣ + iSʸ ⊗ iSʸ + Sᶻ ⊗ Sᶻ = SˣSˣ - SʸSʸ + SᶻSᶻ` on the two legs of
a rung. -/
noncomputable def rungExchange : Matrix (Fin 2 × Fin 2) (Fin 2 × Fin 2) ℝ := ∑ k, P k ⊗ₖ P k

/-- The rotated two-leg ladder with rung coupling `J⊥`, as a reflection-positive ring of rungs. -/
noncomputable def model (Jperp : ℝ) : RPRing (Fin 2 × Fin 2) (Fin 2 × Fin 3) where
  C := fun α ↦ if α.1 = 0 then P α.2 ⊗ₖ 1 else 1 ⊗ₖ P α.2
  o := -Jperp • rungExchange
  C_symm α := by
    split_ifs
    · exact transpose_kronecker_eq_or (P_symm _) (.inl transpose_one)
    · exact transpose_kronecker_eq_or (.inl transpose_one) (P_symm _)
  o_symm := by rw [transpose_smul, rungExchange, transpose_sum_kronecker_self P P_symm]

/-- A certified point: the rung coupling, the seed inverse temperature `β₀` (the seed length is
`n₀ = 4` rungs) and the chain certificate, whose first entries are the seed defects. -/
structure Point where
  /-- The rung coupling `J⊥`. -/
  Jperp : ℚ
  /-- The seed inverse temperature. -/
  β₀ : ℚ
  /-- The chain certificate. -/
  cert : ChainCertificate

/-- The point of `models/heisenberg_ladder`, generated by `lean/scripts/chain_certificate.jl`
from the certified seed defects. -/
def points : List Point := [
  -- J⊥ = 4: bound log 9.033 / 2 ≈ 1.1004; εₛ = 3508321/10⁸, εₜ = 123121/(5 · 10⁶)
  ⟨4, 2, {
    s := [3509e-5, 5119e-6, 7123e-8, 1093e-11, 2402e-19, 1154e-34, 2664e-65, 142e-125, 4033e-249]
    t := [2463e-5, 1599e-6, 537e-8, 578e-13, 6682e-24, 893e-43, 1595e-83, 5089e-163, 518e-321]
    r := 9033e-3
    ε := 4033e-249 }⟩]

/-- The certificate is valid, checked by the kernel. -/
theorem points_valid : ∀ p ∈ points, p.cert.Valid := by decide +kernel

/-- Every seed inverse temperature is positive. -/
theorem points_β₀_pos : ∀ p ∈ points, 0 < p.β₀ := by decide +kernel

/-- The seeds: for every point, `P_s(4, β₀) ≥ 1 - εₛ` and `P_τ(8, β₀) ≥ 1 - εₜ`.
Certified in `models/heisenberg_ladder`. -/
theorem seeds : ∀ p ∈ points,
    1 - (p.cert.sAt 0 : ℝ) ≤ (model p.Jperp).spatialPurity 4 p.β₀ ∧
      1 - (p.cert.tAt 0 : ℝ) ≤ (model p.Jperp).thermalPurity 8 p.β₀ := by
  sorry

/-- **The rotated two-leg ladder.** At every point, every even ring of `L ≥ 4` rungs has a
unique ground state and gap `Δ_L > log r / β₀`. -/
theorem gap {p : Point} (hp : p ∈ points) {L : ℕ} (hL : 4 ≤ L) (hLe : Even L) :
    GapGT ((model p.Jperp).spectrum L) (log (p.cert.r : ℝ) / p.β₀) :=
  (model p.Jperp).gapGT_of_chainCertificate (n₀ := 4) (by norm_num) (by decide)
    (by exact_mod_cast points_β₀_pos p hp) (points_valid p hp) ⟨rfl, rfl, rfl⟩ (seeds p hp).1
    (seeds p hp).2 hL hLe

end CertifiedGaps.HeisenbergLadder
