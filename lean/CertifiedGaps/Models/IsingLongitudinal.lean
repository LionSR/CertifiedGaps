import CertifiedGaps.Ring.Gap

/-!
# The Ising chain in transverse and longitudinal fields

`H_L = -∑ⱼ ZⱼZⱼ₊₁ - g ∑ⱼ Xⱼ - h ∑ⱼ Zⱼ` (Pauli matrices) on a periodic ring; non-integrable for
`h ≠ 0`. It is a reflection-positive ring (`model g h`) with the single bond factor `Z`
(`-h_bond = Z ⊗ Z`) and the real on-site term `-g X - h Z`. No basis change is needed.

The longitudinal field removes the ordered-phase degeneracy, so the grid below includes the
critical point `g = 1` and the ordered phase `g < 1`. Each grid point `p ∈ points` carries its
seed `(6, β₀)` and a rational chain certificate; `points_valid` checks all thirty certificates
by `decide`, and `gap` gives `Δ_L > log r / β₀` for every even `L ≥ 6`.

The seeds are certified in `models/tfim_longitudinal` (complete spectra of the rings of `6`
and `12` sites with rigorous eigenvalue enclosures); `seeds` is the only `sorry`.
-/

open Matrix Real

namespace CertifiedGaps.IsingLongitudinal

/-- The Pauli matrix `Z`. -/
def pauliZ : Matrix (Fin 2) (Fin 2) ℝ := !![1, 0; 0, -1]

/-- The Pauli matrix `X`. -/
def pauliX : Matrix (Fin 2) (Fin 2) ℝ := !![0, 1; 1, 0]

/-- The Ising chain in the fields `(g, h)` as a reflection-positive ring. -/
noncomputable def model (g h : ℝ) : RPRing (Fin 2) (Fin 1) where
  C _ := pauliZ
  o := -g • pauliX - h • pauliZ
  C_symm _ := Or.inl (by ext i j; fin_cases i <;> fin_cases j <;> rfl)
  o_symm := by ext i j; fin_cases i <;> fin_cases j <;> simp [pauliX, pauliZ]

/-- A certified grid point: the fields, the seed inverse temperature `β₀` (the seed length is
`n₀ = 6`) and the chain certificate, whose first entries are the seed defects. -/
structure Point where
  /-- The transverse field. -/
  g : ℚ
  /-- The longitudinal field. -/
  h : ℚ
  /-- The seed inverse temperature. -/
  β₀ : ℚ
  /-- The chain certificate. -/
  cert : ChainCertificate

