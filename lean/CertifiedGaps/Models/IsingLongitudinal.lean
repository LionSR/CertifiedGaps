theorem points_valid : ∀ p ∈ points, p.cert.Valid := by decide +kernel

theorem points_β₀_pos : ∀ p ∈ points, 0 < p.β₀ := by decide +kernel

/-- The seeds: for every grid point, `P_s(6, β₀) ≥ 1 - εₛ` and `P_τ(12, β₀) ≥ 1 - εₜ`.
Certified in `models/tfim_longitudinal`. -/
theorem seeds : ∀ p ∈ points,
    1 - (p.cert.sAt 0 : ℝ) ≤ (model p.g p.h).spatialPurity 6 p.β₀ ∧
      1 - (p.cert.tAt 0 : ℝ) ≤ (model p.g p.h).thermalPurity 12 p.β₀ := by
  sorry

/-- **The Ising chain in transverse and longitudinal fields.** At every grid point, every even
ring of `L ≥ 6` sites has a unique ground state and gap `Δ_L > log r / β₀`. -/
theorem gap {p : Point} (hp : p ∈ points) {L : ℕ} (hL : 6 ≤ L) (hLe : Even L) :
    GapGT ((model p.g p.h).spectrum L) (log (p.cert.r : ℝ) / p.β₀) :=
  (model p.g p.h).gapGT_of_chainCertificate (n₀ := 6) (by norm_num) (by decide)
    (by exact_mod_cast points_β₀_pos p hp) p.cert (points_valid p hp) (seeds p hp).1
    (seeds p hp).2 hL hLe

end CertifiedGaps.IsingLongitudinal
