import CertifiedGaps.Ring.Gap
import CertifiedGaps.Local.SpinHalf
import CertifiedGaps.Local.CellSwap

/-!
# The dimerized spin-one-half Heisenberg chain

`H = ∑ⱼ (1 + δ) S₂ⱼ · S₂ⱼ₊₁ + (1 - δ) S₂ⱼ₊₁ · S₂ⱼ₊₂` on a periodic ring of `2L` spins, as a ring
of `L` cells (the strong pairs). Rotating the second spin of every cell by `e^{iπSʸ}` (a product
of one-site unitaries, so the spectrum is unchanged) turns every bond into
`-SˣSˣ + SʸSʸ - SᶻSᶻ`. In the rotated frame (`model δ`):

* the bond from the second spin of a cell to the first spin of the next is
  `-h = (1 - δ) ∑_α (1 ⊗ Pα) ⊗ (Pα ⊗ 1)` with `Pα = Sˣ, iSʸ, Sᶻ`, that is
  `-h = ∑_α Cα ⊗ (F Cα F)` with `Cα = √(1 - δ) (1 ⊗ Pα)` and `F` the swap of the cell;
* the strong pair is the on-site term `o = -(1 + δ) ∑_α Pα ⊗ Pα`, which commutes with `F`.

So it is a reflection-positive ring with internal reflection `F`. The physical chain is in
`DimerizedHeisenbergPhysical`.

Each point `p ∈ points` carries its dimerization, its seed `(4, β₀)` (cells) and a rational
chain certificate; `gap` gives `Δ_L > log r / β₀` for every even `L ≥ 4`. The seeds are
certified in `models/dimerized_heisenberg` (complete spectra of the rings of `8` and `16`
spins); `seeds` is the only `sorry`.
-/

open Matrix Real
open scoped Kronecker

namespace CertifiedGaps.DimerizedHeisenberg

open SpinHalf

/-- The rotated dimerized chain as a reflection-positive ring of strong pairs. -/
noncomputable def model (δ : ℝ) : RPRing (Fin 2 × Fin 2) (Fin 3) where
  C α := Real.sqrt (1 - δ) • (1 ⊗ₖ P α)
  o := -(1 + δ) • ∑ α, P α ⊗ₖ P α
  C_symm α := transpose_smul_eq_or _ (transpose_kronecker_eq_or (.inl transpose_one) (P_symm α))
  o_symm := by rw [transpose_smul, transpose_sum_kronecker_self P P_symm]
  refl := cellSwap
  refl_symm := cellSwap_transpose
  refl_sq := cellSwap_mul_cellSwap
  refl_o := cellSwap_conj_smul_sum_kronecker_self _ _

/-- A certified point: the dimerization, the seed inverse temperature `β₀` (the seed length is
`n₀ = 4` cells) and the chain certificate, whose first entries are the seed defects. -/
structure Point where
  /-- The dimerization. -/
  δ : ℚ
  /-- The seed inverse temperature. -/
  β₀ : ℚ
  /-- The chain certificate. -/
  cert : ChainCertificate

/-- The three points of `models/dimerized_heisenberg`, generated by
`lean/scripts/chain_certificate.jl` from the certified seed defects. -/
def points : List Point := [
  -- δ = 1/2: bound log 24.33 / 6 ≈ 0.5320
  ⟨1 / 2, 6, {
    s := [1133e-5, 6383e-7, 129e-8, 3908e-15, 3128e-26, 1958e-48, 7668e-93, 1176e-181, 2766e-359]
    t := [1224e-5, 3275e-7, 2156e-10, 9297e-17, 1729e-29, 5979e-55, 715e-105, 1023e-207,
        2094e-411]
    r := 2433e-2
    ε := 2766e-359 }⟩,
  -- δ = 3/10: bound log 3.065 / (13/2) ≈ 0.1723
  ⟨3 / 10, 13 / 2, {
    s := [9516e-5, 4151e-5, 5272e-6, 6201e-8, 7763e-12, 1206e-19, 2909e-35, 1693e-66, 5733e-129]
    t := [518e-4, 1287e-5, 502e-6, 5691e-10, 6567e-16, 8627e-28, 1489e-51, 4435e-99, 3934e-194]
    r := 3065e-3
    ε := 5733e-129 }⟩,
  -- δ = 1/4: bound log 1.514 / (29/4) ≈ 0.0572
  ⟨1 / 4, 29 / 4, {
    s := [1658e-4, 1325e-4, 7345e-5, 1653e-5, 6135e-7, 759e-9, 1153e-15, 2659e-27, 1415e-50]
    t := [5123e-5, 3937e-5, 1438e-5, 1091e-6, 3923e-9, 3703e-14, 2829e-24, 1603e-44, 514e-84]
    r := 1514e-3
    ε := 1415e-50 }⟩]

/-- All three certificates are valid, checked by the kernel. -/
theorem points_valid : ∀ p ∈ points, p.cert.Valid := by decide +kernel

/-- Every seed inverse temperature is positive. -/
theorem points_β₀_pos : ∀ p ∈ points, 0 < p.β₀ := by decide +kernel

/-- Every dimerization is at most one (the bond `1 - δ` is antiferromagnetic or zero). -/
theorem points_δ_le_one : ∀ p ∈ points, p.δ ≤ 1 := by decide +kernel

/-- The seeds: for every point, `P_s(4, β₀) ≥ 1 - εₛ` and `P_τ(8, β₀) ≥ 1 - εₜ`.
Certified in `models/dimerized_heisenberg`. -/
theorem seeds : ∀ p ∈ points,
    1 - (p.cert.sAt 0 : ℝ) ≤ (model p.δ).spatialPurity 4 p.β₀ ∧
      1 - (p.cert.tAt 0 : ℝ) ≤ (model p.δ).thermalPurity 8 p.β₀ := by
  sorry

/-- **The rotated dimerized chain.** At every point, every even ring of `L ≥ 4` cells has a
unique ground state and gap `Δ_L > log r / β₀`. -/
theorem gap {p : Point} (hp : p ∈ points) {L : ℕ} (hL : 4 ≤ L) (hLe : Even L) :
    GapGT ((model p.δ).spectrum L) (log (p.cert.r : ℝ) / p.β₀) :=
  (model p.δ).gapGT_of_chainCertificate (n₀ := 4) (by norm_num) (by decide)
    (by exact_mod_cast points_β₀_pos p hp) (points_valid p hp) ⟨rfl, rfl, rfl⟩ (seeds p hp).1
    (seeds p hp).2 hL hLe

end CertifiedGaps.DimerizedHeisenberg
