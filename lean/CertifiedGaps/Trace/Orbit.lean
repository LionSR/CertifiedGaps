import CertifiedGaps.Ring.Symmetry
import CertifiedGaps.Trace.Frobenius

/-!
# Orbits of representative columns

`gibbsTrace_enclosure_of_rep` (`Trace/Frobenius.lean`) needs one column per orbit: every column
of `F = gibbsHalf H b c` must have the norm of the column at its representative. This file
derives that hypothesis from a set of signed-permutation symmetries of `H`.

* `IsColumnSymmetry H e`: some unit phases `u` make `(e, u)` intertwine `H` with itself
  (`Ring/Symmetry.lean`), so the signed permutation `e_τ ↦ u_τ e_{e τ}` is a unitary symmetry;
  `IsColumnSymmetry.of_int` for an integer matrix with signs `±1`.
* The column symmetries form a submonoid of `Equiv.Perm n` (`columnSymmetries`).
* `nsq_gibbsHalf_rep`: if every `rep r` is `g r` for some `g` in the submonoid generated by
  column symmetries, then `‖F e_r‖ = ‖F e_{rep r}‖` for every `r`: the hypothesis `hrep` of
  `gibbsTrace_enclosure_of_rep`. The representative need not be chosen equivariantly; only the
  exact columns are compared.
-/

open Matrix
open CertifiedGaps.Spectral (nsq)

namespace CertifiedGaps.Trace

variable {n : Type*}

/-- `e` is a **column symmetry** of `H`: with some unit phases `u`, the signed permutation
`e_τ ↦ u_τ e_{e τ}` commutes with `H`. -/
def IsColumnSymmetry (H : Matrix n n ℂ) (e : Equiv.Perm n) : Prop :=
  ∃ u : n → ℂ, (∀ σ, ‖u σ‖ = 1) ∧ Intertwines e u H H

/-- The identity is a column symmetry. -/
theorem IsColumnSymmetry.one (H : Matrix n n ℂ) : IsColumnSymmetry H 1 :=
  ⟨fun _ ↦ 1, fun _ ↦ norm_one, fun σ τ ↦ by simp⟩

/-- Column symmetries compose. -/
theorem IsColumnSymmetry.mul {H : Matrix n n ℂ} {e₁ e₂ : Equiv.Perm n}
    (h₂ : IsColumnSymmetry H e₂) (h₁ : IsColumnSymmetry H e₁) :
    IsColumnSymmetry H (e₂ * e₁) := by
  obtain ⟨u₁, hu₁, h₁⟩ := h₁
  obtain ⟨u₂, hu₂, h₂⟩ := h₂
  exact ⟨fun σ ↦ u₂ (e₁ σ) * u₁ σ, fun σ ↦ by rw [norm_mul, hu₁, hu₂, one_mul], h₁.trans h₂⟩

/-- The column symmetries of `H` as a submonoid of the permutations. -/
def columnSymmetries (H : Matrix n n ℂ) : Submonoid (Equiv.Perm n) where
  carrier := {e | IsColumnSymmetry H e}
  one_mem' := IsColumnSymmetry.one H
  mul_mem' h₁ h₂ := IsColumnSymmetry.mul h₁ h₂

/-- An integer matrix with an integer intertwiner of signs `±1` has the column symmetry over
`ℂ`. -/
theorem IsColumnSymmetry.of_int {A : Matrix n n ℤ} {e : Equiv.Perm n} {u : n → ℤ}
    (hu : ∀ σ, |u σ| = 1) (h : Intertwines e u A A) :
    IsColumnSymmetry (A.map ((↑) : ℤ → ℂ)) e :=
  ⟨fun σ ↦ (u σ : ℂ), fun σ ↦ by rw [Complex.norm_intCast, ← Int.cast_abs, hu, Int.cast_one],
    h.map (Int.castRingHom ℂ)⟩

variable [Fintype n] [DecidableEq n]

/-- **Equal column norms along a symmetry.** -/
theorem IsColumnSymmetry.nsq_gibbsHalf {H : Matrix n n ℂ} {e : Equiv.Perm n}
    (h : IsColumnSymmetry H e) (b c : ℝ) (r : n) :
    nsq (gibbsHalf H b c *ᵥ Pi.single (e r) 1) = nsq (gibbsHalf H b c *ᵥ Pi.single r 1) := by
  obtain ⟨u, hu, hi⟩ := h
  exact nsq_gibbsHalf_single_eq (signedPerm_conjTranspose_mul_self hu) (commute_signedPerm hi)
    b c (hu r) (signedPerm_mulVec_single e u r)

/-- **Representatives from generating symmetries.** If every representative `rep r` is the image
of `r` under a product of column symmetries from `gens`, the column of `F` at `r` has the norm
of the column at `rep r`: the hypothesis `hrep` of `gibbsTrace_enclosure_of_rep`. -/
theorem nsq_gibbsHalf_rep {H : Matrix n n ℂ} (gens : Set (Equiv.Perm n))
    (hgens : ∀ g ∈ gens, IsColumnSymmetry H g) (rep : n → n)
    (hrep : ∀ r, ∃ g ∈ Submonoid.closure gens, g r = rep r) (b c : ℝ) (r : n) :
    nsq (gibbsHalf H b c *ᵥ Pi.single r 1) = nsq (gibbsHalf H b c *ᵥ Pi.single (rep r) 1) := by
  obtain ⟨g, hg, hgr⟩ := hrep r
  have hsym : IsColumnSymmetry H g :=
    (Submonoid.closure_le (S := columnSymmetries H)).2 hgens hg
  rw [← hgr, hsym.nsq_gibbsHalf]

end CertifiedGaps.Trace
